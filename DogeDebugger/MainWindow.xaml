<ui:FluentWindow x:Class="DogeDebugger.MainWindow"
                 x:Name="RootWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
                 xmlns:avalonTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
                 xmlns:local="clr-namespace:DogeDebugger"
                 xmlns:mono="clr-namespace:DogeDebugger.Plugins.CEMono.UI"
                 xmlns:panels="clr-namespace:DogeDebugger.UI.Views.Panels"
                 xmlns:unreal="clr-namespace:DogeDebugger.Plugins.UnrealEngine.UI"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:viewModels="clr-namespace:DogeDebugger.UI.ViewModels"
                 Title="{Binding WindowTitle}"
                 Width="900"
                 Height="600"
                 MinWidth="900"
                 MinHeight="600"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                  PreviewKeyDown="OnMainWindowPreviewKeyDown"
                  FontFamily="{DynamicResource AppUiFontFamily}"
                  FontSize="{DynamicResource AppUiFontSize}"
                  Background="{DynamicResource WindowBackgroundBrush}">
    <ui:FluentWindow.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="29" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActivityButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <Style x:Key="ToolbarIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="MainMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FF1B1B1B" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border x:Name="Border"
                                    Grid.Row="0"
                                    Background="Transparent"
                                    CornerRadius="6">
                                <ContentPresenter x:Name="HeaderPresenter"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Popup x:Name="Popup"
                                   Grid.Row="1"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   PopupAnimation="None">
                                <Border Margin="4,0,4,8"
                                        Padding="0,3,0,3"
                                        Background="{DynamicResource FlyoutBackground}"
                                        BorderBrush="{DynamicResource FlyoutBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <StackPanel IsItemsHost="True" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border"
                                        Property="Background"
                                        Value="{DynamicResource MenuBarItemBackgroundSelected}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition Height="37" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <ui:TitleBar
                     x:Name="AppTitleBar"
                     Title="{Binding WindowTitle}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     Height="30"
                     Padding="16,0,0,0" VerticalAlignment="Center" />

        <Menu x:Name="MainMenu"
              Grid.Row="1"
              Height="30"
              Padding="4,0"
              Visibility="Visible"
              Foreground="#FF1B1B1B"
              TextElement.Foreground="#FF1B1B1B"
              TextElement.FontSize="12"
              Background="#FFFFFFFF"
              VerticalContentAlignment="Center">
            <MenuItem Header="文件(_F)" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="打开进程(_O)"
                          Command="{x:Static local:FileCommands.OpenProcess}"
                          InputGestureText="Ctrl+P">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="FolderOpen24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="附加到进程(_A)"
                          Command="{x:Static local:FileCommands.Attach}"
                          InputGestureText="Alt+A">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="启动调试(_L)"
                          Command="{x:Static local:FileCommands.Launch}"
                          InputGestureText="F3">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="重新开始(_T)"
                          Command="{x:Static local:DebuggerCommands.Restart}"
                          InputGestureText="Ctrl+F2">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowCounterclockwise24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="新建搜索标签(_N)"
                          Command="{x:Static local:MemorySearchCommands.NewTab}"
                          InputGestureText="Ctrl+T">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="TabAdd24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="退出(_X)"
                          Command="{x:Static local:FileCommands.Exit}"
                          InputGestureText="Alt+X" />
            </MenuItem>

            <MenuItem Header="调试(_D)" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="运行(_R)"
                          Command="{x:Static local:DebuggerCommands.Run}"
                          InputGestureText="F9">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="暂停(_P)"
                          Command="{x:Static local:DebuggerCommands.Pause}"
                          InputGestureText="F12">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Pause24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="脱离(_S)"
                          Command="{x:Static local:DebuggerCommands.Detach}"
                          InputGestureText="Ctrl+Alt+F2">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Stop24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="步入(_I)"
                          Command="{x:Static local:DebuggerCommands.StepInto}"
                          InputGestureText="F7">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowStepIn24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="步过(_O)"
                          Command="{x:Static local:DebuggerCommands.StepOver}"
                          InputGestureText="F8">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowStepOver20" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="步出(_U)"
                          Command="{x:Static local:DebuggerCommands.StepOut}"
                          InputGestureText="Ctrl+F9">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowStepOut24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="切换断点(_B)"
                          Command="{x:Static local:DebuggerCommands.ToggleBreakpoint}"
                          InputGestureText="F2">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Record24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="运行到光标(_C)"
                          Command="{x:Static local:DebuggerCommands.RunToCursor}"
                          InputGestureText="F4">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowRight24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="追踪(_T)"
                      IsEnabled="{Binding IsDebuggerPaused}"
                      Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="开始追踪..."
                          Command="{x:Static local:TraceCommands.Start}"
                          InputGestureText="Ctrl+Alt+F7">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="停止追踪"
                          IsEnabled="{Binding IsTraceRunning}"
                          Command="{x:Static local:TraceCommands.Stop}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Stop24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="查看追踪结果"
                          Command="{x:Static local:TraceCommands.ShowResult}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="DataTrending24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="视图(_V)" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="调试">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Bug24" />
                    </MenuItem.Icon>
                    <MenuItem Header="内存搜索"
                              Command="{x:Static local:ViewCommands.MemorySearch}" />
                    <MenuItem Header="反汇编"
                              Command="{x:Static local:ViewCommands.Disassembly}" />
                    <MenuItem Header="笔记"
                              Command="{x:Static local:ViewCommands.Notes}" />
                    <MenuItem Header="断点列表"
                              Command="{x:Static local:ViewCommands.Breakpoints}" />
                    <MenuItem Header="追踪结果"
                              Command="{x:Static local:ViewCommands.TraceResult}" />
                    <MenuItem Header="交叉引用"
                              Command="{x:Static local:ViewCommands.CrossReferences}" />
                    <MenuItem Header="源码调试"
                              Command="{x:Static local:ViewCommands.SourceDebug}" />
                    <Separator />
                    <MenuItem Header="数据视图"
                              Command="{x:Static local:ViewCommands.Hex}" />
                    <MenuItem Header="寄存器"
                              Command="{x:Static local:ViewCommands.Registers}" />
                    <MenuItem Header="调用堆栈"
                              Command="{x:Static local:ViewCommands.CallStack}" />
                    <Separator />
                    <MenuItem Header="AI 助手 (Ctrl+Shift+A)"
                              Click="OnOpenAiAssistantClick" />
                </MenuItem>
                <MenuItem Header="搜索与分析">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </MenuItem.Icon>
                    <MenuItem Header="内存布局"
                              Command="{x:Static local:ViewCommands.MemoryMap}" />
                    <MenuItem Header="字符串引用"
                              Command="{x:Static local:ViewCommands.StringReferences}" />
                    <MenuItem Header="RTTI"
                              Command="{x:Static local:ViewCommands.Rtti}" />
                    <MenuItem Header="线程列表"
                              Command="{x:Static local:ViewCommands.Threads}" />
                    <MenuItem Header="句柄表"
                              Command="{x:Static local:ViewCommands.Handles}" />
                    <MenuItem Header="异常处理"
                              Command="{x:Static local:ViewCommands.Exceptions}" />
                </MenuItem>
                <MenuItem Header="脚本">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Code24" />
                    </MenuItem.Icon>
                    <MenuItem Header="Auto Assembler"
                              Command="{x:Static local:ViewCommands.AutoAssembler}" />
                    <MenuItem Header="Lua 脚本"
                              Command="{x:Static local:ViewCommands.LuaScript}" />
                </MenuItem>
                <MenuItem Header="信息">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </MenuItem.Icon>
                    <MenuItem Header="模块"
                              Command="{x:Static local:ViewCommands.Modules}" />
                    <MenuItem Header="注释"
                              Command="{x:Static local:ViewCommands.Comments}" />
                    <MenuItem Header="自定义符号"
                              Command="{x:Static local:ViewCommands.CustomSymbols}" />
                    <MenuItem Header="日志"
                              Command="{x:Static local:ViewCommands.Log}" />
                </MenuItem>
                <MenuItem x:Name="ExtensionsMenu" Header="扩展">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </MenuItem.Icon>
                    <MenuItem Header="Unity 扩展"
                              Command="{x:Static local:ViewCommands.Unity}" />
                    <MenuItem Header="UnrealEngine 扩展"
                              Command="{x:Static local:ViewCommands.UnrealEngine}" />
                </MenuItem>
                <MenuItem Header="插件"
                          IsEnabled="False">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="侧边栏位置">
                    <MenuItem x:Name="ActivityBarLeftMenuItem"
                              Header="左侧"
                              IsCheckable="True"
                              IsChecked="True"
                              Click="OnActivityBarLeftClick" />
                    <MenuItem x:Name="ActivityBarRightMenuItem"
                              Header="右侧"
                              IsCheckable="True"
                              Click="OnActivityBarRightClick" />
                </MenuItem>
            </MenuItem>

            <MenuItem Header="工具(_T)" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="分配内存"
                          Command="{x:Static local:ToolsCommands.AllocateMemory}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Memory16" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="创建线程"
                          Command="{x:Static local:ToolsCommands.CreateThread}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Call 函数"
                          Command="{x:Static local:ToolsCommands.CallFunction}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Call24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="DLL 注入..."
                          Command="{x:Static local:ToolsCommands.DllInject}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PlugConnected24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="指针扫描"
                          Command="{x:Static local:ToolsCommands.PointerScan}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="BranchFork24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="跨文件特征码搜索"
                          Command="{x:Static local:ToolsCommands.SignatureSearch}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="缓存管理器..."
                          Command="{x:Static local:ToolsCommands.CacheManager}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Storage24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem x:Name="PluginMenu"
                      Header="插件(_P)"
                      Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="插件管理器"
                          Command="{x:Static local:PluginCommands.Manage}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="加载插件..."
                          IsEnabled="False"
                          Command="{x:Static local:PluginCommands.Load}" />
            </MenuItem>

            <MenuItem Header="设置(_S)" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="常规设置"
                          Command="{x:Static local:SettingsCommands.Open}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="快捷键设置…"
                          Command="{x:Static local:SettingsCommands.Shortcuts}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="重置界面布局"
                          Command="{x:Static local:SettingsCommands.ResetLayout}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowReset24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="帮助(_H)" Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="快捷键速查"
                          Command="{x:Static local:HelpCommands.CheatSheet}"
                          InputGestureText="Ctrl+?">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="关于 DogeDebugger"
                          Command="{x:Static local:HelpCommands.About}">
                    <MenuItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Border x:Name="ToolbarDockSlot"
                Grid.Row="2"
                Padding="4,4"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">
                    <Button x:Name="ToolbarRunButton"
                            Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.Run}"
                            ToolTip="运行">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="Play16" />
                            <TextBlock Text="运行" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PassExceptionButton"
                            Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.PassException}"
                            Visibility="Collapsed"
                            ToolTip="不处理异常，交给程序处理">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="ArrowStepBack16" />
                            <TextBlock Text="不处理" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.Pause}"
                            ToolTip="暂停">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="Pause12" />
                            <TextBlock Text="暂停" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToolbarBreakpointButton"
                            Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.ToggleBreakpoint}"
                            ToolTip="切换断点">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="Bug16" />
                            <TextBlock Text="断点" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1"
                               Margin="4,4"
                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Button x:Name="ToolbarStepIntoButton"
                            Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.StepInto}"
                            ToolTip="步入">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="ArrowStepIn16" />
                            <TextBlock Text="步入" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToolbarStepOverButton"
                            Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.StepOver}"
                            ToolTip="步过">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="ArrowStepOver16" />
                            <TextBlock Text="步过" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.StepOut}"
                            ToolTip="步出">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="ArrowStepOut16" />
                            <TextBlock Text="步出" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1"
                               Margin="4,4"
                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{x:Static local:DebuggerCommands.Detach}"
                            ToolTip="脱离">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="ArrowExit20" />
                            <TextBlock Text="脱离" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding LoadSymbolsCommand}"
                            ToolTip="加载 PDB 符号">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="BookInformation20" />
                            <TextBlock Text="加载符号" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1"
                               Margin="4,4"
                               Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <Button Style="{StaticResource ToolbarButton}"
                            Command="{Binding CloseProcessHandleCommand}"
                            ToolTip="关闭当前进程句柄">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,4,0"
                                           Symbol="DismissCircle12" />
                            <TextBlock Text="关闭进程句柄" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ToolbarFloatHandle"
                            Style="{StaticResource ToolbarButton}"
                            Padding="6,4"
                            ToolTip="拖动控制栏">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Symbol="PanelSeparateWindow20" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="ToolbarAiAssistantButton"
                            Style="{StaticResource ToolbarButton}"
                            Height="25"
                            Margin="6,2,4,2"
                            Padding="11.5,4"
                            Click="OnOpenAiAssistantClick"
                            ToolTip="打开 AI 助手">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Style="{StaticResource ToolbarIcon}"
                                           Margin="0,0,5,0"
                                           Symbol="Sparkle20" />
                            <TextBlock Text="AI 助手" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ActivityBarColumn" Width="40" />
                <ColumnDefinition x:Name="DockColumn" Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ActivityBar"
                    Grid.Column="0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                <StackPanel>
                    <Button Style="{StaticResource ActivityButton}"
                            ToolTip="调试"
                            Tag="{x:Static viewModels:PanelGroup.Debugging}"
                            Click="OnPanelGroupClick">
                        <Grid Width="40" Height="40">
                            <Border x:Name="DebuggingGroupIndicator"
                                    Width="3"
                                    Margin="0,6"
                                    HorizontalAlignment="Left"
                                    Background="#FF0067C0" />
                            <ui:SymbolIcon Symbol="Bug24"
                                           FontSize="20"
                                           Foreground="#E4000000" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            ToolTip="搜索与分析"
                            Tag="{x:Static viewModels:PanelGroup.SearchAndAnalysis}"
                            Click="OnPanelGroupClick">
                        <Grid Width="40" Height="40">
                            <Border x:Name="SearchAndAnalysisGroupIndicator"
                                    Width="3"
                                    Margin="0,6"
                                    HorizontalAlignment="Left"
                                    Background="#00FFFFFF" />
                            <ui:SymbolIcon Symbol="Search24"
                                           FontSize="20"
                                           Foreground="#9E000000" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            ToolTip="脚本"
                            Tag="{x:Static viewModels:PanelGroup.Scripting}"
                            Click="OnPanelGroupClick">
                        <Grid Width="40" Height="40">
                            <Border x:Name="ScriptingGroupIndicator"
                                    Width="3"
                                    Margin="0,6"
                                    HorizontalAlignment="Left"
                                    Background="#00FFFFFF" />
                            <ui:SymbolIcon Symbol="Code24"
                                           FontSize="20"
                                           Foreground="#9E000000" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            ToolTip="信息"
                            Tag="{x:Static viewModels:PanelGroup.Information}"
                            Click="OnPanelGroupClick">
                        <Grid Width="40" Height="40">
                            <Border x:Name="InformationGroupIndicator"
                                    Width="3"
                                    Margin="0,6"
                                    HorizontalAlignment="Left"
                                    Background="#00FFFFFF" />
                            <ui:SymbolIcon Symbol="Info24"
                                           FontSize="20"
                                           Foreground="#9E000000" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            ToolTip="扩展"
                            Tag="{x:Static viewModels:PanelGroup.Extensions}"
                            Click="OnPanelGroupClick">
                        <Grid Width="40" Height="40">
                            <Border x:Name="ExtensionsGroupIndicator"
                                    Width="3"
                                    Margin="0,6"
                                    HorizontalAlignment="Left"
                                    Background="#00FFFFFF" />
                            <ui:SymbolIcon Symbol="PuzzlePiece24"
                                           FontSize="20"
                                           Foreground="#9E000000" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource ActivityButton}"
                            ToolTip="插件"
                            Tag="{x:Static viewModels:PanelGroup.Plugins}"
                            Click="OnPanelGroupClick">
                        <Grid Width="40" Height="40">
                            <Border x:Name="PluginsGroupIndicator"
                                    Width="3"
                                    Margin="0,6"
                                    HorizontalAlignment="Left"
                                    Background="#00FFFFFF" />
                            <ui:SymbolIcon Symbol="PlugConnected24"
                                           FontSize="20"
                                           Foreground="#9E000000" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <avalonDock:DockingManager Grid.Column="1"
                                       x:Name="DockManager"
                                       AllowMixedOrientation="True">
                <avalonDock:DockingManager.Theme>
                    <avalonTheme:Vs2013LightTheme />
                </avalonDock:DockingManager.Theme>
                <avalonDock:LayoutRoot>
                    <avalonDock:LayoutPanel Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPane>
                            <avalonDock:LayoutDocument x:Name="MemorySearchDocument"
                                                       Title="内存搜索"
                                                       ContentId="MemorySearchPanel"
                                                       CanClose="False">
                                <panels:MemorySearchWorkspaceView DataContext="{Binding MemorySearchWorkspace}" />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="DisassemblyDocument"
                                                       Title="反汇编"
                                                       ContentId="DisassemblyPanel"
                                                       CanClose="False">
                                <avalonDock:DockingManager x:Name="DisasmDockManager"
                                                           AllowMixedOrientation="True">
                                    <avalonDock:DockingManager.Theme>
                                        <avalonTheme:Vs2013LightTheme />
                                    </avalonDock:DockingManager.Theme>
                                    <avalonDock:LayoutRoot>
                                        <avalonDock:LayoutPanel Orientation="Horizontal">
                                            <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical"
                                                                                     DockWidth="*">
                                                <avalonDock:LayoutAnchorablePane>
                                                    <avalonDock:LayoutAnchorable Title="反汇编"
                                                                                 ContentId="DisassemblyView"
                                                                                 CanClose="False"
                                                                                 CanHide="False"
                                                                                 CanFloat="True"
                                                                                 IsSelected="True">
                                                        <avalonDock:LayoutAnchorable.Content>
                                                            <panels:DisassemblyView
                                                                x:Name="DisassemblyViewControl"
                                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </avalonDock:LayoutAnchorable.Content>
                                                    </avalonDock:LayoutAnchorable>
                                                </avalonDock:LayoutAnchorablePane>
                                                <avalonDock:LayoutAnchorablePane>
                                                    <avalonDock:LayoutAnchorable Title="数据视图"
                                                                                 ContentId="HexView"
                                                                                 CanClose="False"
                                                                                 CanHide="False"
                                                                                 CanFloat="True"
                                                                                 IsSelected="True">
                                                        <avalonDock:LayoutAnchorable.Content>
                                                            <panels:HexView
                                                                x:Name="HexViewControl"
                                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </avalonDock:LayoutAnchorable.Content>
                                                    </avalonDock:LayoutAnchorable>
                                                </avalonDock:LayoutAnchorablePane>
                                            </avalonDock:LayoutAnchorablePaneGroup>
                                            <avalonDock:LayoutAnchorablePaneGroup Orientation="Vertical"
                                                                                     DockWidth="*">
                                                <avalonDock:LayoutAnchorablePane>
                                                    <avalonDock:LayoutAnchorable Title="寄存器(双击在数据视图跳转)"
                                                                                 ContentId="RegisterView"
                                                                                 CanClose="False"
                                                                                 CanHide="False"
                                                                                 CanFloat="True"
                                                                                 IsSelected="True">
                                                        <avalonDock:LayoutAnchorable.Content>
                                                            <panels:RegisterView
                                                                x:Name="RegisterViewControl"
                                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </avalonDock:LayoutAnchorable.Content>
                                                    </avalonDock:LayoutAnchorable>
                                                </avalonDock:LayoutAnchorablePane>
                                                <avalonDock:LayoutAnchorablePane>
                                                    <avalonDock:LayoutAnchorable Title="调用堆栈"
                                                                                 ContentId="CallStackView"
                                                                                 CanClose="False"
                                                                                 CanHide="False"
                                                                                 CanFloat="True"
                                                                                 IsSelected="True">
                                                        <avalonDock:LayoutAnchorable.Content>
                                                            <panels:CallStackView
                                                                x:Name="CallStackViewControl"
                                                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                        </avalonDock:LayoutAnchorable.Content>
                                                    </avalonDock:LayoutAnchorable>
                                                </avalonDock:LayoutAnchorablePane>
                                            </avalonDock:LayoutAnchorablePaneGroup>
                                        </avalonDock:LayoutPanel>
                                    </avalonDock:LayoutRoot>
                                </avalonDock:DockingManager>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="SourceDebugDocument"
                                                       Title="源码调试"
                                                       ContentId="SourceDebugPanel"
                                                       CanClose="False">
                                <panels:SourceDebugView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="NotesDocument"
                                                       Title="笔记"
                                                       ContentId="NotesPanel"
                                                       CanClose="False">
                                <panels:NotesView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="BreakpointsDocument"
                                                       Title="断点列表"
                                                       ContentId="BreakpointPanel"
                                                       CanClose="False">
                                <panels:BreakpointListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="CrossReferencesDocument"
                                                       Title="交叉引用"
                                                       ContentId="CrossRefPanel"
                                                       CanClose="False">
                                <panels:CrossRefListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="MemoryMapDocument"
                                                       Title="内存布局"
                                                       ContentId="MemoryMapPanel"
                                                       CanClose="False">
                                <panels:MemoryMapView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="StringReferencesDocument"
                                                       Title="字符串引用"
                                                       ContentId="StringRefPanel"
                                                       CanClose="False">
                                <panels:StringRefListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="RttiDocument"
                                                       Title="RTTI"
                                                       ContentId="RttiPanel"
                                                       CanClose="False">
                                <panels:RttiView DataContext="{Binding RttiPanel}" />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="UnrealExplorerDocument"
                                                       Title="UnrealEngine 扩展"
                                                       ContentId="UnrealExplorerPanel"
                                                       CanClose="False">
                                <unreal:UnrealExplorerView DataContext="{Binding UnrealPanel}" />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="MonoExplorerDocument"
                                                       Title="Unity 扩展"
                                                       ContentId="MonoExplorerPanel"
                                                       CanClose="False">
                                <mono:MonoExplorerView DataContext="{Binding MonoPanel}" />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="ThreadsDocument"
                                                       Title="线程列表"
                                                       ContentId="ThreadListPanel"
                                                       CanClose="False">
                                <panels:ThreadListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="HandlesDocument"
                                                       Title="句柄表"
                                                       ContentId="HandleListPanel"
                                                       CanClose="False">
                                <panels:HandleListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="ExceptionsDocument"
                                                       Title="异常处理"
                                                       ContentId="ExceptionHandlerPanel"
                                                       CanClose="False">
                                <panels:ExceptionHandlerView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="ModulesDocument"
                                                       Title="模块"
                                                       ContentId="ModuleListPanel"
                                                       CanClose="False">
                                <panels:ModuleListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="CommentsDocument"
                                                       Title="注释"
                                                       ContentId="CommentPanel"
                                                       CanClose="False">
                                <panels:CommentListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="CustomSymbolsDocument"
                                                       Title="自定义符号"
                                                       ContentId="CustomSymbolPanel"
                                                       CanClose="False">
                                <panels:CustomSymbolListView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="LogDocument"
                                                       Title="日志"
                                                       ContentId="LogPanel"
                                                       CanClose="False">
                                <panels:LogView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="TraceResultDocument"
                                                       Title="追踪结果"
                                                       ContentId="TraceResultPanel"
                                                       CanClose="False">
                                <Grid Margin="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding TraceSummaryText}" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <Button Content="导出"
                                                    Click="OnExportTraceClick" />
                                            <Button Content="清除"
                                                    Click="OnClearTraceClick" />
                                        </StackPanel>
                                    </Grid>
                                    <DataGrid Grid.Row="1"
                                              ItemsSource="{Binding TraceSteps}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              BorderThickness="0"
                                              EnableRowVirtualization="True"
                                              FontFamily="Cascadia Code, Consolas, monospace"
                                              FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#"
                                                                Binding="{Binding StepIndex}"
                                                                Width="70" />
                                            <DataGridTextColumn Header="RIP"
                                                                Binding="{Binding Rip, StringFormat=0x{0:X}}"
                                                                Width="140" />
                                            <DataGridTextColumn Header="模块偏移"
                                                                Binding="{Binding ModuleOffsetText}"
                                                                Width="180" />
                                            <DataGridTextColumn Header="指令"
                                                                Binding="{Binding DisassemblyText}"
                                                                Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="AutoAssemblerDocument"
                                                       Title="Auto Assembler"
                                                       ContentId="AutoAssemblerPanel"
                                                       CanClose="False">
                                <panels:AutoAssemblerView />
                            </avalonDock:LayoutDocument>

                            <avalonDock:LayoutDocument x:Name="LuaDocument"
                                                       Title="Lua 脚本"
                                                       ContentId="LuaScriptPanel"
                                                       CanClose="False">
                                <panels:LuaScriptView />
                            </avalonDock:LayoutDocument>
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutPanel>
                </avalonDock:LayoutRoot>
            </avalonDock:DockingManager>
        </Grid>

        <GridSplitter x:Name="ScriptConsoleSplitter"
                      Grid.Row="4"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Visibility="Collapsed" />

        <Border x:Name="ScriptConsoleBar"
                Grid.Row="5"
                Visibility="Collapsed" />

        <Border x:Name="StatusBar"
                Grid.Row="6"
                Height="24"
                Padding="6,0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="60"
                        Background="#FF0067C0"
                        Padding="10,0">
                    <TextBlock x:Name="StatusLabel"
                               Text="{Binding StatusLabelText}"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <Rectangle Grid.Column="1"
                           Width="1"
                           Margin="0,3"
                           Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <TextBlock x:Name="StatusDescription"
                           Grid.Column="2"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Text="{Binding StatusDescriptionText}" />
                <TextBlock Grid.Column="3"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding TargetText}" />
                <ProgressBar x:Name="StatusProgress"
                             Grid.Column="4"
                             Width="160"
                             Height="12"
                             Margin="4,0,8,0"
                             Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid x:Name="ShortcutCheatSheetOverlay"
              Grid.RowSpan="4"
              Panel.ZIndex="100"
              Background="#99000000"
              Visibility="Collapsed">
            <Border Width="1170"
                    Height="682"
                    Padding="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFF7F7F7"
                    BorderBrush="#FFD5D5D5"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Keyboard20"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                            <TextBlock FontSize="18"
                                       FontWeight="Bold"
                                       Text="快捷键速查" />
                            <TextBlock Margin="16,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FF777777"
                                       Text="当前方案: x64dbg" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <TextBlock Margin="0,0,10,0"
                                       VerticalAlignment="Center"
                                       Foreground="#FF999999"
                                       Text="Esc 关闭 · 在「设置 → 快捷键」中查看" />
                            <ui:Button Width="32"
                                       Height="28"
                                       Padding="0"
                                       Click="OnCloseCheatSheetClick"
                                       ToolTip="关闭">
                                <ui:SymbolIcon Symbol="Dismiss12" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="0,16,0,0"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CheatSheetGroups">
                            <ItemsControl.Width>930</ItemsControl.Width>
                            <ItemsControl.HorizontalAlignment>Left</ItemsControl.HorizontalAlignment>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4"
                                            Padding="12"
                                            Background="White"
                                            BorderBrush="#FFE2E2E2"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="{Binding Icon}"
                                                               Margin="0,0,6,0" />
                                                <TextBlock FontWeight="SemiBold"
                                                           Text="{Binding Name}" />
                                            </StackPanel>
                                            <ItemsControl Margin="0,8,0,0"
                                                          ItemsSource="{Binding Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Foreground="#FF555555"
                                                                       Text="{Binding Name}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Margin="12,0,0,0"
                                                                       Foreground="#FF444444"
                                                                       Text="{Binding Gesture}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
