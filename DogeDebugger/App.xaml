<Application x:Class="DogeDebugger.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnMainWindowClose"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFAFAFA" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FFD5DBE1" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF1769AA" />
            <Style TargetType="Button">
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="MinWidth" Value="60" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
