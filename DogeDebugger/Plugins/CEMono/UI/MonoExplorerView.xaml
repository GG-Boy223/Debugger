<UserControl x:Class="DogeDebugger.Plugins.CEMono.UI.MonoExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Cascadia Code, Consolas, monospace"
             FontSize="12">
    <UserControl.Resources>
        <Style x:Key="ExpandToggle"
               TargetType="ToggleButton">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="16"
                                Height="16"
                                Background="Transparent">
                            <TextBlock x:Name="Glyph"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI Symbol"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="⊞" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Glyph"
                                        Property="Text"
                                        Value="⊟" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="4,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="0,0,3,0"
                               Command="{Binding InjectMonoCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PlugConnected24"
                                           Margin="0,0,5,0" />
                            <TextBlock Text="注入Mono" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="0,0,3,0"
                               Command="{Binding DisconnectCommand}"
                               Content="断开" />
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="0,0,3,0"
                               Command="{Binding RefreshTreeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24"
                                           Margin="0,0,5,0" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="0,0,3,0"
                               Command="{Binding ExportSelectedImageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DocumentArrowDown24"
                                           Margin="0,0,5,0" />
                            <TextBlock Text="导出程序集" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Command="{Binding ApplyAssemblySymbolsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24"
                                           Margin="0,0,5,0" />
                            <TextBlock Text="应用程序集符号" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="1"
                     Height="3"
                     Minimum="0"
                     Maximum="1"
                     Value="{Binding Progress}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="220" MinWidth="150" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top"
                           Padding="4,3"
                           Text="程序集" />
                <ListBox ItemsSource="{Binding Images}"
                         SelectedItem="{Binding SelectedImage}"
                         DisplayMemberPath="Name"
                         BorderThickness="0"
                         Background="Transparent" />
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top"
                           Padding="4,3"
                           Text="类" />
                <ui:TextBox DockPanel.Dock="Top"
                            Margin="4,0,4,4"
                            Height="30"
                            Padding="6,3"
                            PlaceholderText="搜索类名"
                            Text="{Binding ClassSearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ListBox ItemsSource="{Binding FilteredClasses}"
                         SelectedItem="{Binding SelectedClass}"
                         DisplayMemberPath="DisplayName"
                         BorderThickness="0"
                         Background="Transparent" />
            </DockPanel>

            <GridSplitter Grid.Column="3"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="4,3"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="类信息" />
                </Border>

                <Border Grid.Row="1"
                        Padding="4,3"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock FontWeight="SemiBold"
                               Text="继承关系" />
                </Border>
                <TextBlock Grid.Row="2"
                           Padding="4,4"
                           TextWrapping="Wrap"
                           Text="{Binding ClassInheritanceChain}" />

                <Border Grid.Row="3"
                        Padding="4,3"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                    <TextBlock FontWeight="SemiBold"
                               Text="静态字段" />
                </Border>
                <DataGrid Grid.Row="4"
                          ItemsSource="{Binding StaticFields}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="138" />
                        <DataGridTextColumn Header="类型"
                                            Binding="{Binding TypeName}"
                                            Width="138" />
                        <DataGridTextColumn Header="地址"
                                            Binding="{Binding Address}"
                                            Width="120" />
                        <DataGridTextColumn Header="值"
                                            Binding="{Binding Value}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="5"
                        Padding="4,3"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,1">
                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="字段" />
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Text="地址" />
                            <ComboBox Width="180"
                                      Height="28"
                                      ItemsSource="{Binding InstanceAddresses}"
                                      SelectedItem="{Binding SelectedInstanceAddress}" />
                            <ui:Button Margin="4,0,0,0"
                                       Padding="8,3"
                                       Command="{Binding LookupInstancesCommand}"
                                       Content="搜索实例" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="6"
                          ItemsSource="{Binding Fields}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="偏移"
                                            Binding="{Binding OffsetText}"
                                            Width="70" />
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="190" />
                        <DataGridTextColumn Header="值"
                                            Binding="{Binding Value}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Padding="6,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <DockPanel>
                <TextBlock FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding StatusText}" />
                <Border />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
