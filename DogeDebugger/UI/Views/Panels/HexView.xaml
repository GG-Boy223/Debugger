<UserControl x:Class="DogeDebugger.UI.Views.Panels.HexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:DogeDebugger.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Orientation="Horizontal">
                <ui:Button Width="24"
                           Height="30"
                           Padding="0"
                           Appearance="Transparent"
                           ToolTip="上一个内存视图"
                           Click="OnPreviousHexTab">
                    <TextBlock Text="◀" />
                </ui:Button>
                <ui:Button Width="24"
                           Height="30"
                           Padding="0"
                           Appearance="Transparent"
                           ToolTip="下一个内存视图"
                           Click="OnNextHexTab">
                    <TextBlock Text="▶" />
                </ui:Button>
            </StackPanel>
            <TabControl x:Name="HexTabs"
                        Grid.Column="1"
                        Height="31"
                        BorderThickness="0"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=内存 {0}}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </Grid>

        <Border Grid.Row="1"
                Padding="6,2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding TargetText}" />
                <TextBlock DockPanel.Dock="Right"
                           HorizontalAlignment="Right"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding StatusText}" />
                <Border />
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding HexLines}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="32"
                  GridLinesVisibility="None"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  BorderThickness="0"
                  Background="Transparent"
                  FontFamily="Cascadia Code, Consolas, monospace"
                  FontSize="12">
            <DataGrid.Columns>
                <DataGridTextColumn Header=""
                                    Binding="{Binding AddressText}"
                                    Width="130" />
                <DataGridTextColumn Header="00 01 02 03 04 05 06 07 08 09 0A 0B 0C 0D 0E 0F"
                                    Binding="{Binding Hex}"
                                    Width="500" />
                <DataGridTextColumn Header="ASCII"
                                    Binding="{Binding Ascii}"
                                    Width="200" />
            </DataGrid.Columns>
        </DataGrid>
        <controls:PanelProcessOverlay Grid.Row="0"
                                      Grid.RowSpan="3" />
    </Grid>
</UserControl>
