<UserControl x:Class="DogeDebugger.UI.Views.Panels.AutoAssemblerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,4,6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="状态: " />
                        <Run FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{Binding AutoAssemblerStatusText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="活动脚本: " />
                        <Run FontWeight="SemiBold"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Text="{Binding AutoAssemblerActiveScriptText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button Appearance="Primary"
                               Command="{Binding EnableAutoAssemblerCommand}"
                               FontSize="12"
                               Margin="0,0,4,0"
                               Padding="10,4">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Filled="False"
                                           FontFamily="{DynamicResource FluentSystemIcons}"
                                           FontSize="12"
                                           Symbol="Play24" />
                        </ui:Button.Icon>
                        启用
                    </ui:Button>
                    <ui:Button Command="{Binding DisableAutoAssemblerCommand}"
                               FontSize="12"
                               Margin="0,0,4,0"
                               Padding="10,4">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Filled="False"
                                           FontFamily="{DynamicResource FluentSystemIcons}"
                                           FontSize="12"
                                           Symbol="Stop24" />
                        </ui:Button.Icon>
                        禁用
                    </ui:Button>
                    <ui:DropDownButton FontSize="12"
                                       Margin="0,0,4,0"
                                       Padding="10,4">
                        <ui:DropDownButton.Flyout>
                            <ContextMenu>
                                <MenuItem Click="OnInsertBasicTemplateClick"
                                          Header="基础脚本" />
                                <Separator />
                                <MenuItem Click="OnInsertJump5TemplateClick"
                                          Header="代码注入 (5字节跳转)" />
                                <MenuItem Click="OnInsertJump14TemplateClick"
                                          Header="代码注入 (14字节跳转)" />
                                <MenuItem Click="OnInsertAobTemplateClick"
                                          Header="AOB注入" />
                            </ContextMenu>
                        </ui:DropDownButton.Flyout>
                        <ui:DropDownButton.Icon>
                            <ui:SymbolIcon Filled="False"
                                           FontFamily="{DynamicResource FluentSystemIcons}"
                                           FontSize="12"
                                           Symbol="DocumentBulletList24" />
                        </ui:DropDownButton.Icon>
                        示例
                    </ui:DropDownButton>
                    <ui:Button Command="{Binding ClearAutoAssemblerOutputCommand}"
                               FontSize="12"
                               Padding="10,4">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Filled="False"
                                           FontFamily="{DynamicResource FluentSystemIcons}"
                                           FontSize="12"
                                           Symbol="Delete24" />
                        </ui:Button.Icon>
                        清空输出
                    </ui:Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Canvas x:Name="LineNumberCanvas"
                        Width="44"
                        ClipToBounds="True">
                    <TextBlock x:Name="LineNumberBlock"
                               Width="44"
                               Padding="6,4,8,4"
                               FontFamily="Consolas, Consolas, monospace"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               IsHitTestVisible="False"
                               Text="1"
                               TextAlignment="Right" />
                </Canvas>
            </Border>
            <RichTextBox x:Name="ScriptEditor"
                         Grid.Column="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         BorderThickness="0,0,0,0"
                         FontFamily="Consolas, Consolas, monospace"
                         FontSize="14"
                         HorizontalScrollBarVisibility="Disabled"
                         Padding="4,4,8,4"
                         VerticalScrollBarVisibility="Auto">
                <RichTextBox.Resources>
                    <Style TargetType="Paragraph">
                        <Setter Property="Margin" Value="0,0,0,0" />
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="4"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <TextBox x:Name="OutputLog"
                 Grid.Row="3"
                 AcceptsReturn="True"
                 BorderThickness="0,0,0,0"
                 FontFamily="Consolas, Consolas, monospace"
                 FontSize="13"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 IsReadOnly="True"
                 Padding="8,4,8,4"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 xml:space="preserve" />

        <Border x:Name="ProcessOverlay"
                Grid.RowSpan="4"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                IsHitTestVisible="True"
                Opacity="1"
                Visibility="{Binding AutoAssemblerOverlayVisibility}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:SymbolIcon HorizontalAlignment="Center"
                               Margin="0,0,0,8"
                               FontFamily="{DynamicResource FluentSystemIcons}"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Symbol="PlugDisconnected24" />
                <TextBlock HorizontalAlignment="Center"
                           Margin="0,0,0,4"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="等待选择进程" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="通过 文件 → 打开进程 选择目标进程" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
