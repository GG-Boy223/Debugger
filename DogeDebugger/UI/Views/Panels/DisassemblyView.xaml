<UserControl x:Class="DogeDebugger.UI.Views.Panels.DisassemblyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:DogeDebugger.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="21"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Width="21"
                        Height="18"
                        Margin="1,0"
                        Padding="0"
                        Command="{Binding GoBackCommand}"
                        Content="◀" />
                <Button Width="21"
                        Height="18"
                        Margin="1,0"
                        Padding="0"
                        Command="{Binding GoForwardCommand}"
                        Content="▶" />
                <Rectangle Width="1"
                           Height="14"
                           Margin="4,2"
                           Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <Button Width="34"
                        Height="18"
                        Margin="1,0"
                        Padding="2,0"
                        Command="{Binding NavigateCommand}"
                        Content="跳转" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="InstructionGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Disassembly}"
                  SelectedItem="{Binding SelectedInstruction}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="32"
                  GridLinesVisibility="Horizontal"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  BorderThickness="0"
                  Background="Transparent"
                  FontFamily="Cascadia Code, Consolas, monospace"
                  FontSize="12"
                  MouseDoubleClick="OnInstructionGridDoubleClick">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="#E4000000" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                                     Value="True">
                            <Setter Property="Background" Value="#FFCCE8FF" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="地址"
                                    Binding="{Binding AddressText}"
                                    Width="190" />
                <DataGridTextColumn Header="字节"
                                    Binding="{Binding BytesText}"
                                    Width="100" />
                <DataGridTemplateColumn Header="指令"
                                        Width="360">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Foreground="#FF0000A8"
                                     FontWeight="SemiBold"
                                     Text="{Binding Mnemonic}" />
                                <Run Text=" " />
                                <Run Foreground="#FF333333"
                                     Text="{Binding Operands}" />
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="注释"
                                    Binding="{Binding FlowControl}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>
        <controls:PanelProcessOverlay Grid.Row="0"
                                      Grid.RowSpan="2" />
    </Grid>
</UserControl>
