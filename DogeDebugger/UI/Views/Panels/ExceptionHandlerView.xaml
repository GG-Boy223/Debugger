<UserControl x:Class="DogeDebugger.UI.Views.Panels.ExceptionHandlerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:DogeDebugger.UI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="29" />
            <RowDefinition Height="*" />
            <RowDefinition Height="21" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="6,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <ui:Button Width="63"
                           Height="22"
                           HorizontalAlignment="Left"
                           Appearance="Primary"
                           Command="{Binding RefreshExceptionHandlersCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24"
                                       FontSize="12"
                                       Margin="0,0,5,0" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </ui:Button>
                <TextBlock HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Text="{Binding ExceptionHandlerStatusText}" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="VEH / VCH">
                <DataGrid ItemsSource="{Binding VehEntries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Width="40"
                                            Binding="{Binding Index}" />
                        <DataGridTextColumn Header="异常处理地址"
                                            Width="160"
                                            Binding="{Binding DisplayDecodedAddress}" />
                        <DataGridTextColumn Header="模块"
                                            Width="150"
                                            Binding="{Binding ModuleName}" />
                        <DataGridTextColumn Header="符号"
                                            Width="*"
                                            Binding="{Binding SymbolName}" />
                        <DataGridTextColumn Header="类型"
                                            Width="60"
                                            Binding="{Binding TypeName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="异常Hook">
                <DataGrid ItemsSource="{Binding HookEntries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="函数"
                                            Width="220"
                                            Binding="{Binding FunctionName}" />
                        <DataGridTextColumn Header="地址"
                                            Width="160"
                                            Binding="{Binding DisplayAddress}" />
                        <DataGridTextColumn Header="状态"
                                            Width="100"
                                            Binding="{Binding Status}" />
                        <DataGridTextColumn Header="预期指令"
                                            Width="120"
                                            Binding="{Binding ExpectedInstruction}" />
                        <DataGridTextColumn Header="实际指令"
                                            Width="*"
                                            Binding="{Binding ActualInstruction}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header=".pdata SEH">
                <DataGrid ItemsSource="{Binding PdataEntries}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#"
                                            Width="40"
                                            Binding="{Binding Index}" />
                        <DataGridTextColumn Header="函数范围"
                                            Width="280"
                                            Binding="{Binding DisplayFunctionRange}" />
                        <DataGridTextColumn Header="Handler"
                                            Width="160"
                                            Binding="{Binding DisplayHandler}" />
                        <DataGridTextColumn Header="Handler 符号"
                                            Width="580"
                                            Binding="{Binding HandlerSymbol}" />
                        <DataGridTextColumn Header="模块"
                                            Width="150"
                                            Binding="{Binding ModuleName}" />
                        <DataGridTextColumn Header="标志"
                                            Width="100"
                                            Binding="{Binding FlagNames}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2"
                Padding="8,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding ExceptionHandlerStatusText}" />
        </Border>

        <controls:PanelProcessOverlay Grid.Row="0"
                                      Grid.RowSpan="3" />
    </Grid>
</UserControl>
