<UserControl x:Class="DogeDebugger.UI.Views.Panels.SourceDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             DataContext="{Binding SourceDebugPanel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <HierarchicalDataTemplate x:Key="ParameterTemplate"
                                  ItemsSource="{Binding Children}">
            <Grid MinHeight="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Margin="6,0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding Type}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2"
                           Margin="6,0,2,0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           Text="{Binding Value}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="8,6"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Margin="0,0,8,0"
                                Padding="7,2"
                                CornerRadius="3"
                                Background="{DynamicResource AccentFillColorSecondaryBrush}">
                            <TextBlock MaxWidth="190"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       Text="{Binding CurrentModuleText}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock MaxWidth="330"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentFileText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding CurrentLocationText}"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Margin="8,0,0,0"
                                Padding="6,1"
                                CornerRadius="3"
                                Background="#28E68C14"
                                Visibility="{Binding IsApproximate, Converter={StaticResource BoolToVis}}">
                            <TextBlock FontSize="10.5"
                                       Foreground="#FFE68C14"
                                       Text="近似定位" />
                        </Border>
                        <TextBlock Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding PanelStatusText}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,4,0"
                                   Padding="8,3"
                                   FontSize="11.5"
                                   Command="{Binding RefreshIndexCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowSync24" />
                            </ui:Button.Icon>
                            <TextBlock Text="刷新索引" />
                        </ui:Button>
                        <ui:Button Padding="8,3"
                                   FontSize="11.5"
                                   Command="{Binding LocateCurrentCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Location24" />
                            </ui:Button.Icon>
                            <TextBlock Text="定位当前地址" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,6,0,0"
                        Padding="9,6"
                        CornerRadius="4"
                        Background="#24E68C14"
                        BorderBrush="#80E68C14"
                        BorderThickness="1"
                        Visibility="{Binding HasNavigationWarning, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right"
                                   Margin="10,0,0,0"
                                   Padding="8,3"
                                   FontSize="11"
                                   Command="{Binding OpenUnverifiedSourceCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentSearch24" />
                            </ui:Button.Icon>
                            <TextBlock Text="仍然以只读方式打开" />
                        </ui:Button>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="#FFE68C14"
                                           Symbol="Warning20" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="11"
                                       Text="{Binding NavigationWarningText}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="360" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TabControl x:Name="DocumentTabs"
                            BorderThickness="0"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            ItemsSource="{Binding Documents}"
                            SelectedItem="{Binding SelectedDocument, Mode=TwoWay}">
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Text}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     Padding="4,3,12,3"
                                     FontFamily="Cascadia Code, Consolas, monospace"
                                     FontSize="12" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,0">
                                <ui:Button DockPanel.Dock="Right"
                                           Width="20"
                                           Height="20"
                                           Margin="7,0,0,0"
                                           Padding="2"
                                           Appearance="Transparent"
                                           Tag="{Binding}"
                                           ToolTip="关闭"
                                           Click="OnCloseDocumentClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Dismiss12"
                                                       FontSize="16" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <TextBlock MaxWidth="210"
                                           VerticalAlignment="Center"
                                           FontSize="11.5"
                                           Text="{Binding Title}"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="关闭"
                                      Click="OnCloseSelectedDocumentClick" />
                            <MenuItem Header="关闭其他标签"
                                      Click="OnCloseOtherDocumentsClick" />
                        </ContextMenu>
                    </TabControl.ContextMenu>
                </TabControl>
                <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDocuments}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ui:SymbolIcon Margin="0,0,0,10"
                                       HorizontalAlignment="Center"
                                       FontSize="48"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Symbol="DocumentSearch24" />
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="暂无源码位置" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="异常或用户执行断点命中已加载 PDB 的模块后，将在此处打开经过校验的本地源码。"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0"
                               Margin="10,8,8,5">
                        <TextBlock DockPanel.Dock="Left"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="变量" />
                        <TextBlock DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Text="{Binding ParameterStatusText}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Grid Grid.Row="1"
                          Height="27"
                          Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="145" />
                            <ColumnDefinition Width="125" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Text="名称" />
                        <TextBlock Grid.Column="1"
                                   Margin="6,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Text="类型" />
                        <TextBlock Grid.Column="2"
                                   Margin="6,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Text="值" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <TreeView ItemsSource="{Binding Parameters}"
                                  ItemTemplate="{StaticResource ParameterTemplate}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Padding="3,3,0,3"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded"
                                            Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Stretch" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                        <StackPanel Margin="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasParameters}"
                                                     Value="False">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <ui:SymbolIcon Margin="0,0,0,8"
                                           HorizontalAlignment="Center"
                                           FontSize="36"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Symbol="BracesVariable24" />
                            <TextBlock FontSize="11.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding ParameterStatusText}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
