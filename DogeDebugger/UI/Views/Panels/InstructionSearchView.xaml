<UserControl x:Class="DogeDebugger.UI.Views.Panels.InstructionSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Height="39"
              Margin="6,0,6,0">
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding QueryLabelText}" />
                <TextBlock Margin="6,0,15,0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           Text="{Binding InstructionText}" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding PatternLabelText}" />
                <TextBlock Margin="6,0,27,0"
                           VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           Text="{Binding InstructionBytesText}" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           Text="{Binding ModulesText}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center"
                           Text="过滤:" />
                <TextBox Width="220"
                         Height="30"
                         Margin="6,0,0,0"
                         Padding="6,4"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button Width="59"
                           Height="22"
                           Margin="6,0,0,0"
                           Padding="0"
                           Appearance="Secondary"
                           Command="{Binding StopCommand}"
                           Content="停止" />
            </StackPanel>
        </Grid>

        <DataGrid x:Name="ResultGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding FilteredResults}"
                  SelectedItem="{Binding SelectedResult}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="32"
                  RowHeight="32"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="Transparent"
                  FontFamily="Cascadia Code, Consolas, monospace"
                  FontSize="12"
                  MouseDoubleClick="OnResultGridDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="地址"
                                    Binding="{Binding AddressText}"
                                    Width="147" />
                <DataGridTextColumn Header="模块"
                                    Binding="{Binding ModuleName}"
                                    Width="147" />
                <DataGridTextColumn Header="模块偏移"
                                    Binding="{Binding ModuleOffsetText}"
                                    Width="237" />
                <DataGridTextColumn Header="字节码"
                                    Binding="{Binding BytesText}"
                                    Width="157" />
                <DataGridTextColumn Header="反汇编"
                                    Binding="{Binding Disassembly}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Margin="6,4,6,4"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="{Binding SummaryText}" />
    </Grid>
</UserControl>
