<UserControl x:Class="DogeDebugger.UI.Views.Panels.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <DataGrid ItemsSource="{Binding Registers}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="32"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="Transparent"
                  FontFamily="Cascadia Code, Consolas, monospace"
                  FontSize="12"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="寄存器"
                                    Binding="{Binding Name}"
                                    Width="90" />
                <DataGridTextColumn Header="值"
                                    Binding="{Binding ValueText}"
                                    Width="740" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Panel.ZIndex="5"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDebuggerPaused}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="LockClosed24"
                               FontSize="38"
                               Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="调试中断后可用" />
                <TextBlock Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="附加调试器且线程中断后此面板可用" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
