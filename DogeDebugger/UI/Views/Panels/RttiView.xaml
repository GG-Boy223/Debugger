<UserControl x:Class="DogeDebugger.UI.Views.Panels.RttiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="39" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="4,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel HorizontalAlignment="Left"
                            Orientation="Horizontal">
                    <TextBlock Margin="4,0,6,0"
                               VerticalAlignment="Center"
                               Text="地址:" />
                    <TextBox x:Name="BaseAddressInput"
                             Width="180"
                             Height="31"
                             Padding="8,4"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Width="40"
                               Height="23"
                               Margin="6,0,0,0"
                               Padding="4,2"
                               Appearance="Secondary"
                               Command="{Binding ApplyAddressCommand}"
                               Content="应用" />
                    <ui:Button Width="82"
                               Height="23"
                               Margin="4,0,0,0"
                               Padding="7,2"
                               Appearance="Secondary"
                               Command="{Binding AddSelectedFieldCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="并排添加" />
                        </StackPanel>
                    </ui:Button>
                    <Separator Width="1"
                               Margin="8,2" />
                    <ui:Button Width="70"
                               Height="23"
                               Padding="7,2"
                               Appearance="Secondary"
                               Command="{Binding CreateClassCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="添加类" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Width="70"
                               Height="23"
                               Margin="4,0,0,0"
                               Padding="7,2"
                               Appearance="Secondary"
                               Command="{Binding RemoveSelectedClassCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="删除类" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Width="64"
                               Height="23"
                               Margin="4,0,0,0"
                               Padding="6,2"
                               Appearance="Secondary"
                               Command="{Binding AutoGuessCommand}"
                               Content="自动猜测"
                               IsEnabled="{Binding HasSelectedClass}" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <CheckBox x:Name="AllowEditCheck"
                              Width="120"
                              Height="32"
                              VerticalContentAlignment="Center"
                              IsChecked="{Binding AllowEditValues}"
                              Content="允许修改值"
                              AutomationProperties.AutomationId="AllowEditCheck" />
                    <CheckBox x:Name="AutoRefreshCheck"
                              Width="120"
                              Height="32"
                              VerticalContentAlignment="Center"
                              IsChecked="{Binding AutoRefresh}"
                              Content="自动刷新"
                              AutomationProperties.AutomationId="AutoRefreshCheck" />
                    <ui:Button x:Name="SaveButton"
                               Width="58"
                               Height="23"
                               Padding="6,2"
                               Appearance="Secondary"
                               Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="保存" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="LoadButton"
                               Width="58"
                               Height="23"
                               Margin="4,0,0,0"
                               Padding="6,2"
                               Appearance="Secondary"
                               Command="{Binding LoadProjectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="加载" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="ClassTree"
                      Grid.Column="0"
                      ItemsSource="{Binding Classes}"
                      BorderThickness="0"
                      Background="Transparent"
                      FontFamily="Cascadia Code, Consolas, monospace"
                      FontSize="11"
                      SelectedItemChanged="OnClassTreeSelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Fields}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <Grid Grid.Column="2">
                <DataGrid x:Name="FieldsGrid"
                          ItemsSource="{Binding Fields}"
                          SelectedItem="{Binding SelectedField}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          Background="Transparent"
                          FontFamily="Cascadia Code, Consolas, monospace"
                          FontSize="11"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="偏移"
                                            Binding="{Binding OffsetText}"
                                            Width="70" />
                        <DataGridTextColumn Header="类型"
                                            Binding="{Binding TypeText}"
                                            Width="180" />
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="220" />
                        <DataGridTextColumn Header="值"
                                            Binding="{Binding Value}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Panel.ZIndex="5"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Fields.Count, Mode=OneWay}"
                                             Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="请选择或创建一个 RTTI 类" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
