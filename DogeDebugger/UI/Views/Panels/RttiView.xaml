<UserControl x:Class="DogeDebugger.UI.Views.Panels.RttiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="4,3"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <TextBlock Margin="4,0,6,0"
                               VerticalAlignment="Center"
                               Text="地址:" />
                    <TextBox Width="180"
                             Height="31"
                             Padding="8,4"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="4,0,2,0"
                               Command="{Binding ApplyAddressCommand}"
                               Content="应用" />
                    <Separator Margin="5,2" />
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="2,0"
                               Command="{Binding AddSelectedFieldCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="并排添加" />
                        </StackPanel>
                    </ui:Button>
                    <Separator Margin="5,2" />
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="9,3"
                               Margin="2,0"
                               Command="{Binding CreateClassCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="添加类" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <CheckBox Margin="8,0,4,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AllowEditValues}"
                              Content="允许修改值" />
                    <CheckBox Margin="4,0,8,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding AutoRefresh}"
                              Content="自动刷新" />
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="8,3"
                               Margin="2,0"
                               Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Save16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="保存" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="8,3"
                               Margin="2,0"
                               Command="{Binding LoadProjectCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="加载" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
                <Border />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Padding="4,2"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="8,3"
                               Margin="0,0,4,0"
                               Command="{Binding RemoveSelectedClassCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete16"
                                           Margin="0,0,4,0" />
                            <TextBlock Text="删除类" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               FontSize="11"
                               Padding="8,3"
                               Command="{Binding AutoGuessCommand}"
                               Content="自动猜测" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="8,0,4,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding StatusText}" />
                <Border />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Classes}"
                      SelectedItem="{Binding SelectedClass}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      FontFamily="Cascadia Code, Consolas, monospace"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="结构"
                                        Binding="{Binding Name}"
                                        Width="*" />
                    <DataGridTextColumn Header="基址"
                                        Binding="{Binding BaseAddressText}"
                                        Width="102" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding Fields}"
                      SelectedItem="{Binding SelectedField}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      Background="Transparent"
                      FontFamily="Cascadia Code, Consolas, monospace"
                      FontSize="12"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="偏移"
                                        Binding="{Binding OffsetText}"
                                        Width="72" />
                    <DataGridTextColumn Header="类型"
                                        Binding="{Binding TypeText}"
                                        Width="100" />
                    <DataGridTextColumn Header="名称"
                                        Binding="{Binding Name}"
                                        Width="180" />
                    <DataGridTextColumn Header="值"
                                        Binding="{Binding Value}"
                                        Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="2"
                    Panel.ZIndex="5"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Fields.Count, Mode=OneWay}"
                                         Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Text="请选择或创建一个 RTTI 类" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
