<UserControl x:Class="DogeDebugger.UI.Views.Panels.CrossRefListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:DogeDebugger.UI.Controls"
             DataContext="{Binding CrossRefPanel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground"
                    Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="6,4"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <ui:Button Appearance="Primary"
                                   Margin="0,0,4,0"
                                   Padding="8,3"
                                   FontSize="11"
                                   Command="{Binding AnalyzeModuleCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Library24" />
                            </ui:Button.Icon>
                            <TextBlock Text="选择模块并分析" />
                        </ui:Button>
                        <ui:Button Appearance="Danger"
                                   Margin="0,0,8,0"
                                   Padding="8,3"
                                   FontSize="11"
                                   Command="{Binding StopScanCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Stop24" />
                            </ui:Button.Icon>
                            <TextBlock Text="停止" />
                        </ui:Button>
                        <TextBlock Margin="8,0,0,0"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource SectionLabel}"
                                   Text="{Binding AnalyzedModuleText}" />
                        <TextBlock Margin="12,0,0,0"
                                   Style="{StaticResource SectionLabel}"
                                   Text="{Binding DatabaseStatsText}" />
                    </StackPanel>
                    <Border />
                </DockPanel>
            </Border>

            <Grid Grid.Row="1"
                  Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Height="4"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding Progress}" />
                <TextBlock Grid.Column="1"
                           Margin="8,2,6,2"
                           VerticalAlignment="Center"
                           FontSize="10"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ProgressMessage}" />
            </Grid>

            <Border Grid.Row="2"
                    Padding="6"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Margin="2,0,6,0"
                               FontWeight="SemiBold"
                               Style="{StaticResource SectionLabel}"
                               Text="目标:" />
                    <TextBox x:Name="TargetBox"
                             Grid.Column="1"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="12"
                             Text="{Binding TargetInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="输入地址 / 模块+偏移 / 导出符号 / 寄存器(例如 RIP)"
                             KeyDown="OnTargetKeyDown" />
                    <ui:Button Grid.Column="2"
                               Margin="6,0,0,0"
                               Padding="6,3"
                               FontSize="11"
                               Appearance="Secondary"
                               Click="OnUseRipClick">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Target24" />
                        </ui:Button.Icon>
                        <TextBlock Text="使用 RIP" />
                    </ui:Button>
                    <ui:Button Grid.Column="3"
                               Margin="4,0,0,0"
                               Padding="8,3"
                               FontSize="11"
                               Appearance="Primary"
                               Command="{Binding ResolveTargetCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowRight24" />
                        </ui:Button.Icon>
                        <TextBlock Text="定位" />
                    </ui:Button>
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="函数列表" />
                            <StackPanel DockPanel.Dock="Right"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="过滤:" />
                                <TextBox x:Name="FunctionFilterBox"
                                         Width="160"
                                         FontFamily="Cascadia Code, Consolas, monospace"
                                         FontSize="11"
                                         Text="{Binding FunctionFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <Border />
                        </DockPanel>
                    </Border>
                    <DataGrid x:Name="FunctionGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding FilteredFunctions}"
                              SelectedItem="{Binding SelectedFunction, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              Background="Transparent"
                              FontFamily="Cascadia Code, Consolas, monospace"
                              FontSize="12"
                              MouseDoubleClick="OnFunctionGridDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="在反汇编中查看(_D)"
                                          Tag="navigate"
                                          Click="OnFunctionMenuClick" />
                                <Separator />
                                <MenuItem Header="复制地址"
                                          Tag="copyAddress"
                                          Click="OnFunctionMenuClick" />
                                <MenuItem Header="复制名称"
                                          Tag="copyName"
                                          Click="OnFunctionMenuClick" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="地址"
                                                Binding="{Binding StartRvaHex}"
                                                Width="140" />
                            <DataGridTextColumn Header="名称"
                                                Binding="{Binding DisplayName}"
                                                Width="*" />
                            <DataGridTextColumn Header="引用"
                                                Binding="{Binding XrefCount}"
                                                Width="52" />
                            <DataGridTextColumn Header="来源"
                                                Binding="{Binding SourceTag}"
                                                Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <GridSplitter Grid.Column="1"
                              Width="4"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Columns"
                              Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Padding="6,4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Text="调用方 (引用此函数的位置)" />
                            <TextBlock DockPanel.Dock="Right"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource SectionLabel}">
                                共 <Run Text="{Binding CurrentReferences.Count, Mode=OneWay}" /> 条
                            </TextBlock>
                            <Border />
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1"
                            Padding="8,4"
                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <TextBlock FontFamily="Cascadia Code, Consolas, monospace"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding TargetResolvedText}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                    <DataGrid x:Name="XrefGrid"
                              Grid.Row="2"
                              ItemsSource="{Binding CurrentReferences}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              EnableRowVirtualization="True"
                              Background="Transparent"
                              FontFamily="Cascadia Code, Consolas, monospace"
                              FontSize="12"
                              MouseDoubleClick="OnXrefGridDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="在反汇编中查看调用点(_C)"
                                          Tag="navigateSource"
                                          Click="OnXrefMenuClick" />
                                <MenuItem Header="在反汇编中查看调用方函数(_F)"
                                          Tag="navigateCaller"
                                          Click="OnXrefMenuClick" />
                                <Separator />
                                <MenuItem Header="复制调用点地址"
                                          Tag="copyAddress"
                                          Click="OnXrefMenuClick" />
                                <MenuItem Header="复制调用方名称"
                                          Tag="copyCaller"
                                          Click="OnXrefMenuClick" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="调用点"
                                                Binding="{Binding SourceVaHex}"
                                                Width="140" />
                            <DataGridTextColumn Header="类型"
                                                Binding="{Binding TypeText}"
                                                Width="60" />
                            <DataGridTextColumn Header="调用方"
                                                Binding="{Binding CallerDisplay}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Opacity="0.4"
                               Text="选择左侧函数或在上方输入地址以查看调用方">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentReferences.Count}"
                                                 Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>

            <Border Grid.Row="4"
                    Padding="8,3"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        函数: <Run FontWeight="SemiBold" Text="{Binding TotalFunctions}" />
                        显示: <Run FontWeight="SemiBold"
                                   Text="{Binding FilteredFunctions.Count, Mode=OneWay}" />
                        交叉引用: <Run FontWeight="SemiBold" Text="{Binding TotalXrefs}" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding ProgressMessage}" />
                    <Border />
                </DockPanel>
            </Border>
        </Grid>

        <Border Panel.ZIndex="20"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                IsHitTestVisible="True">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasDatabase}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel MaxWidth="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:SymbolIcon Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontSize="48"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Symbol="Link24" />
                <TextBlock Margin="0,0,0,6"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="交叉引用未就绪" />
                <TextBlock Margin="0,0,0,4"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="该功能需要先对某个模块进行完整的静态反汇编扫描。"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,0,0,16"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Text="点击下方按钮选择模块并开始分析。对于较大的模块，此过程可能需要较长时间。"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ui:Button HorizontalAlignment="Center"
                           Padding="14,6"
                           Appearance="Primary"
                           Command="{Binding AnalyzeModuleCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Play24" />
                    </ui:Button.Icon>
                    <TextBlock Text="选择模块并开始分析" />
                </ui:Button>
            </StackPanel>
        </Border>

        <Border Panel.ZIndex="30"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="True">
            <StackPanel MaxWidth="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ui:SymbolIcon Margin="0,0,0,8"
                               HorizontalAlignment="Center"
                               FontSize="48"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                               Symbol="DocumentSearch24" />
                <TextBlock Margin="0,0,0,12"
                           HorizontalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding AnalyzedModuleText}" />
                <ProgressBar Width="360"
                             Height="6"
                             Margin="0,0,0,8"
                             Minimum="0"
                             Maximum="1"
                             Value="{Binding Progress}" />
                <TextBlock Margin="0,0,0,16"
                           HorizontalAlignment="Center"
                           FontFamily="Cascadia Code, Consolas, monospace"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="{Binding ProgressMessage}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <ui:Button HorizontalAlignment="Center"
                           Padding="12,5"
                           Appearance="Danger"
                           Command="{Binding StopScanCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Stop24" />
                    </ui:Button.Icon>
                    <TextBlock Text="取消分析" />
                </ui:Button>
            </StackPanel>
        </Border>

        <controls:PanelProcessOverlay />
    </Grid>
</UserControl>
