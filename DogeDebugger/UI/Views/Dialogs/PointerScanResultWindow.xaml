<Window x:Class="DogeDebugger.UI.Views.Dialogs.PointerScanResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="指针扫描结果"
        Width="950"
        Height="650"
        MinWidth="700"
        MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="#FFFAFAFA">
    <DockPanel Background="#FFFAFAFA">
        <ToolBar DockPanel.Dock="Top"
                 ToolBarTray.IsLocked="True">
            <Button x:Name="NewScanButton"
                    Click="OnNewScanClick"
                    Content="新扫描"
                    ToolTip="开始新的指针扫描" />
            <Separator />
            <Button x:Name="RescanButton"
                    Click="OnRescanClick"
                    Content="重新扫描"
                    ToolTip="验证并过滤现有结果（需已有扫描结果）" />
            <Separator />
            <Button x:Name="SaveButton"
                    Click="OnSaveClick"
                    Content="保存"
                    ToolTip="保存结果到文件" />
            <Button x:Name="LoadButton"
                    Click="OnLoadClick"
                    Content="加载"
                    ToolTip="从文件加载结果" />
            <Separator />
            <ToggleButton x:Name="ModuleFilterToggle"
                          Content="模块筛选 ▾"
                          ToolTip="按基址模块筛选结果" />
            <Popup x:Name="ModuleFilterPopup"
                   PlacementTarget="{Binding ElementName=ModuleFilterToggle}"
                   Placement="Bottom"
                   StaysOpen="False"
                   PopupAnimation="Fade"
                   AllowsTransparency="True"
                   IsOpen="{Binding IsChecked, ElementName=ModuleFilterToggle, Mode=TwoWay}">
                <Border MinWidth="200"
                        MaxHeight="350"
                        Padding="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Width="50"
                                    Margin="0,0,4,0"
                                    Click="OnSelectAllModulesClick"
                                    Content="全选" />
                            <Button Width="50"
                                    Margin="0,0,4,0"
                                    Click="OnSelectNoModulesClick"
                                    Content="全不选" />
                            <Button Width="50"
                                    Click="OnApplyModuleFilterClick"
                                    Content="应用" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ModuleFilters, RelativeSource={RelativeSource AncestorType=Window}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Margin="2"
                                                  IsChecked="{Binding IsChecked}"
                                                  Content="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>
            <Separator />
            <Button x:Name="CancelScanButton"
                    Click="OnCancelScanClick"
                    Content="取消"
                    ToolTip="取消当前扫描" />
        </ToolBar>

        <StackPanel DockPanel.Dock="Top">
            <ProgressBar x:Name="ScanProgressBar"
                         Height="4"
                         Maximum="100"
                         Value="0" />
            <TextBlock x:Name="ProgressText"
                       Margin="8,2"
                       FontSize="11"
                       Foreground="#FF808080" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom"
              Margin="8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="PreviousPageButton"
                        Width="24"
                        Margin="0,0,4,0"
                        Click="OnPreviousPageClick"
                        Content="&lt;" />
                <TextBlock VerticalAlignment="Center"
                           Foreground="#E4000000">
                    页
                    <Run x:Name="CurrentPageRun"
                         Text="1" />
                    /
                    <Run x:Name="TotalPagesRun"
                         Text="1" />
                </TextBlock>
                <Button x:Name="NextPageButton"
                        Width="24"
                        Margin="4,0,0,0"
                        Click="OnNextPageClick"
                        Content="&gt;" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Grid.Column="1"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#FF808080"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2"
                       VerticalAlignment="Center"
                       Foreground="#E4000000">
                共
                <Run x:Name="ResultCountRun"
                     Text="0" />
                条结果
            </TextBlock>
        </Grid>

        <ui:ListView x:Name="ResultList"
                     Margin="8,4"
                     Padding="0"
                     Background="#FFF3F3F3"
                     BorderBrush="#0F000000"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="#E4000000"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewMouseRightButtonDown="OnResultPreviewMouseRightButtonDown"
                     MouseDoubleClick="OnResultMouseDoubleClick">
            <ui:ListView.View>
                <ui:GridView x:Name="ResultGridView">
                    <GridViewColumn Width="160"
                                    Header="基址"
                                    DisplayMemberBinding="{Binding BaseAddress}" />
                    <GridViewColumn Width="160"
                                    Header="指向"
                                    DisplayMemberBinding="{Binding PointsTo}" />
                </ui:GridView>
            </ui:ListView.View>
            <ui:ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="添加到地址列表"
                              Click="OnAddToAddressListClick" />
                    <MenuItem Header="复制指针链"
                              Click="OnCopyPointerChainClick" />
                </ContextMenu>
            </ui:ListView.ContextMenu>
        </ui:ListView>
    </DockPanel>
</Window>
