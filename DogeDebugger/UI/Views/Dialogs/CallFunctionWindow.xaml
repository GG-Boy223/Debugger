<Window x:Class="DogeDebugger.UI.Views.Dialogs.CallFunctionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Call 函数"
        Width="440"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppUiFontFamily}"
        FontSize="{DynamicResource AppUiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16,12,16,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="调用地址 (十六进制):" />
        <TextBox x:Name="AddressBox"
                 Grid.Row="1"
                 Height="31"
                 Margin="0,4,0,0"
                 FontFamily="Cascadia Code, Consolas, monospace" />

        <TextBlock Grid.Row="2"
                   Margin="0,14,0,0"
                   Text="参数 (留空则不传递):" />
        <Grid Grid.Row="3"
              Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数1:" />
            <TextBox x:Name="Param1Box"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="31"
                     Margin="0,0,0,4"
                     FontFamily="Cascadia Code, Consolas, monospace" />
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数2:" />
            <TextBox x:Name="Param2Box"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="31"
                     Margin="0,0,0,4"
                     FontFamily="Cascadia Code, Consolas, monospace" />
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数3:" />
            <TextBox x:Name="Param3Box"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="31"
                     Margin="0,0,0,4"
                     FontFamily="Cascadia Code, Consolas, monospace" />
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数4:" />
            <TextBox x:Name="Param4Box"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="31"
                     FontFamily="Cascadia Code, Consolas, monospace" />
        </Grid>

        <ui:Button x:Name="ExpandToggle"
                   Grid.Row="4"
                   Width="144"
                   Height="30"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Left"
                   Click="OnExpandToggleClick"
                   Content="展开更多参数 (5-8)" />

        <Grid x:Name="AdditionalParametersGrid"
              Grid.Row="5"
              Margin="0,4,0,0"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数5:" />
            <TextBox x:Name="Param5Box"
                     Grid.Row="0"
                     Grid.Column="1"
                     Height="31"
                     Margin="0,0,0,4"
                     FontFamily="Cascadia Code, Consolas, monospace" />
            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数6:" />
            <TextBox x:Name="Param6Box"
                     Grid.Row="1"
                     Grid.Column="1"
                     Height="31"
                     Margin="0,0,0,4"
                     FontFamily="Cascadia Code, Consolas, monospace" />
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数7:" />
            <TextBox x:Name="Param7Box"
                     Grid.Row="2"
                     Grid.Column="1"
                     Height="31"
                     Margin="0,0,0,4"
                     FontFamily="Cascadia Code, Consolas, monospace" />
            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="参数8:" />
            <TextBox x:Name="Param8Box"
                     Grid.Row="3"
                     Grid.Column="1"
                     Height="31"
                     FontFamily="Cascadia Code, Consolas, monospace" />
        </Grid>

        <Grid Grid.Row="6"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       Text="注入模式:" />
            <RadioButton x:Name="ModeNormalRadio"
                         Grid.Column="1"
                         Margin="0,0,30,0"
                         VerticalAlignment="Center"
                         IsChecked="True"
                         Content="普通远线程" />
            <RadioButton x:Name="ModeDhsRadio"
                         Grid.Column="2"
                         VerticalAlignment="Center"
                         IsEnabled="False"
                         Content="DHS 注入 (主线程)" />
        </Grid>

        <Grid Grid.Row="7"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Margin="0,0,7,0"
                       VerticalAlignment="Center"
                       Text="返回值:" />
            <TextBox x:Name="ReturnValueBox"
                     Grid.Column="1"
                     Height="31"
                     IsReadOnly="True"
                     FontFamily="Cascadia Code, Consolas, monospace" />
        </Grid>

        <StackPanel Grid.Row="8"
                    Margin="0,12,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ui:Button x:Name="ExecuteButton"
                       Width="80"
                       Height="31"
                       Margin="0,0,8,0"
                       Appearance="Primary"
                       Click="OnExecuteClick"
                       Content="执行" />
            <ui:Button Width="80"
                       Height="31"
                       Click="OnCloseClick"
                       Content="关闭" />
        </StackPanel>
    </Grid>
</Window>
