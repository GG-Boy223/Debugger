<Window x:Class="DogeDebugger.UI.Views.Dialogs.ManualAddressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="添加地址"
        Width="520"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#FFF8F8F8"
        Foreground="#E4000000"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Grid Margin="16,5,16,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="31" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="33" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="33" />
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="31" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,7,0,4"
                   Text="地址:" />
        <Grid Grid.Row="1">
            <TextBox x:Name="AddressBox"
                     Width="440"
                     Height="31"
                     HorizontalAlignment="Left"
                     Padding="6,4"
                     AutomationProperties.AutomationId="AddressBox"
                     FontFamily="Cascadia Code, Consolas, monospace"
                     TextChanged="OnAddressTextChanged" />
            <TextBlock x:Name="ValuePreview"
                       Width="24"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="=???" />
        </Grid>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,4"
                   Text="描述" />
        <TextBox x:Name="DescriptionBox"
                 Grid.Row="3"
                 Width="472"
                 Height="33"
                 Padding="6,5"
                 AutomationProperties.AutomationId="DescriptionBox" />

        <TextBlock Grid.Row="4"
                   Margin="0,10,0,4"
                   Text="类型" />
        <ComboBox x:Name="TypeCombo"
                  Grid.Row="5"
                  Width="472"
                  Height="33"
                  AutomationProperties.AutomationId="TypeCombo"
                  SelectionChanged="OnTypeSelectionChanged" />

        <CheckBox x:Name="HexCheck"
                  Grid.Row="6"
                  Width="120"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="HexCheck"
                  Content="十六进制" />
        <CheckBox x:Name="SignedCheck"
                  Grid.Row="6"
                  Width="120"
                  Margin="136,16,0,0"
                  HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="SignedCheck"
                  Content="有符号" />
        <CheckBox x:Name="PointerCheck"
                  Grid.Row="7"
                  Width="120"
                  Margin="0,24,0,0"
                  HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="PointerCheck"
                  Content="指针" />

        <StackPanel Grid.Row="9"
                    Margin="0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <ui:Button Width="80"
                       Height="31"
                       Padding="0"
                       Content="确认"
                       Click="OnConfirmClick" />
            <ui:Button Width="80"
                       Height="31"
                       Margin="8,0,0,0"
                       Padding="0"
                       Content="取消"
                       Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
