<Window x:Class="DogeDebugger.UI.Views.Dialogs.SignatureSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="跨版本特征码定位"
        Width="1400"
        Height="900"
        MinWidth="1180"
        MinHeight="800"
        WindowStartupLocation="CenterOwner"
        Background="#FFFAFAFA"
        Foreground="#E4000000">
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="14,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="A" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="9,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="参考版本" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="从旧版目标提炼多条独立定位器" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <RadioButton x:Name="ASourceCacheRadio"
                                         Margin="0,0,10,0"
                                         Checked="OnASourceModeChanged"
                                         Content="缓存" />
                            <RadioButton x:Name="ASourceExternalRadio"
                                         Checked="OnASourceModeChanged"
                                         Content="外部文件" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="ASourceCachePanel"
                          Grid.Row="1"
                          MinHeight="66">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="静态分析缓存对" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ACacheCombo"
                                      MinHeight="31"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="OnACacheSelectionChanged" />
                            <ui:Button Grid.Column="1"
                                       Margin="8,0,0,0"
                                       Padding="12,5"
                                       Appearance="Secondary"
                                       Click="OnRefreshCacheClick"
                                       Content="刷新" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="ASourceExternalPanel"
                          Grid.Row="1"
                          MinHeight="66"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Width="68"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="程序文件" />
                        <TextBox x:Name="AFilePathBox"
                                 Grid.Column="1"
                                 MinHeight="28"
                                 IsReadOnly="True" />
                        <ui:Button Grid.Column="2"
                                   Margin="7,0,0,0"
                                   Padding="10,4"
                                   Appearance="Secondary"
                                   Click="OnBrowseASourceClick"
                                   Content="选择…" />
                    </Grid>
                    <Border Grid.Row="2"
                            Margin="0,9,0,0"
                            Padding="9,7"
                            CornerRadius="5"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="ASourceMetadataText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ASourceStatusText"
                                       Grid.Row="1"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="28"
                                Height="28"
                                CornerRadius="14"
                                Background="{DynamicResource SystemFillColorCautionBrush}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="B" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="9,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="目标版本" />
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="缓存文件或当前进程中的目标模块" />
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <RadioButton x:Name="BSourceCacheRadio"
                                         Margin="0,0,8,0"
                                         Checked="OnBSourceModeChanged"
                                         Content="缓存" />
                            <RadioButton x:Name="BSourceExternalRadio"
                                         Margin="0,0,8,0"
                                         Checked="OnBSourceModeChanged"
                                         Content="外部文件" />
                            <RadioButton x:Name="BSourceCurrentProcessRadio"
                                         Checked="OnBSourceModeChanged"
                                         Content="当前进程" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="BSourceCachePanel"
                          Grid.Row="1"
                          MinHeight="66">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Margin="0,0,0,4"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="静态分析缓存对" />
                        <ComboBox x:Name="BCacheCombo"
                                  Grid.Row="1"
                                  MinHeight="31"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="OnBCacheSelectionChanged" />
                    </Grid>
                    <Grid x:Name="BSourceExternalPanel"
                          Grid.Row="1"
                          MinHeight="66"
                          Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Width="68"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="程序文件" />
                        <TextBox x:Name="BFilePathBox"
                                 Grid.Column="1"
                                 MinHeight="28"
                                 IsReadOnly="True" />
                        <ui:Button Grid.Column="2"
                                   Margin="7,0,0,0"
                                   Padding="10,4"
                                   Appearance="Secondary"
                                   Click="OnBrowseBSourceClick"
                                   Content="选择…" />
                    </Grid>
                    <Grid x:Name="BSourceCurrentProcessPanel"
                          Grid.Row="1"
                          MinHeight="66"
                          Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentProcessText"
                                       Margin="0,0,0,4"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ui:Button Grid.Column="1"
                                       Margin="8,-3,0,2"
                                       Padding="9,3"
                                       Appearance="Secondary"
                                       Click="OnRefreshModulesClick"
                                       Content="刷新模块" />
                        </Grid>
                        <ComboBox x:Name="BModuleCombo"
                                  Grid.Row="1"
                                  MinHeight="31"
                                  DisplayMemberPath="Name" />
                    </Grid>
                    <Border Grid.Row="2"
                            Margin="0,9,0,0"
                            Padding="9,7"
                            CornerRadius="5"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="BSourceMetadataText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="BSourceStatusText"
                                       Grid.Row="1"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3.5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Padding="12,9,12,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Text="批量目标（名字=十六进制偏移，每行一个）" />
                    <TextBox x:Name="BatchTargetsBox"
                             Grid.Row="1"
                             Height="88"
                             Margin="0"
                             Padding="6"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             TextWrapping="NoWrap" />
                </Grid>
            </Border>
            <Border Grid.Column="2"
                    Padding="12,19,12,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Text="目标类型" />
                    <ComboBox x:Name="TargetKindCombo"
                              MinHeight="31"
                              Margin="0" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="StartBatchButton"
                                   Grid.Column="0"
                                   Height="34"
                                   Margin="0,0,8,0"
                                   IsEnabled="False"
                                   Click="OnStartBatchClick"
                                   Content="开始批量定位" />
                        <ui:Button x:Name="CancelTaskButton"
                                   Grid.Column="1"
                                   Width="82"
                                   Height="34"
                                   IsEnabled="False"
                                   Click="OnCancelTaskClick"
                                   Content="取消任务" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2"
              Margin="0,13,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BatchReadyText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="准备就绪" />
                <TextBlock x:Name="BatchStatusText"
                           Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="BatchProgressText"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="0%" />
            </Grid>
            <Grid Grid.Row="1"
                  Margin="0,5,0,0">
                <ProgressBar x:Name="BatchProgressBar"
                             Height="4"
                             Maximum="100" />
            </Grid>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="1"
                CornerRadius="7"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="12,6,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold"
                               Text="批量定位结果" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="运行批量定位后，所有目标会集中显示在此处。" />
                </Grid>
                <DataGrid x:Name="TargetResultsGrid"
                          Grid.Row="1"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          MouseDoubleClick="OnTargetResultsMouseDoubleClick"
                          PreviewKeyDown="OnTargetResultsPreviewKeyDown"
                          SelectionChanged="OnTargetResultsSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="行"
                                            Binding="{Binding RowNumber}"
                                            Width="50" />
                        <DataGridTextColumn Header="名称"
                                            Binding="{Binding Name}"
                                            Width="180" />
                        <DataGridTextColumn Header="A 版偏移"
                                            Binding="{Binding SourceOffsetText}"
                                            Width="110" />
                        <DataGridTextColumn Header="处理状态"
                                            Binding="{Binding StateText}"
                                            Width="100" />
                        <DataGridTextColumn Header="B 版偏移"
                                            Binding="{Binding EffectiveOffsetText}"
                                            Width="110" />
                        <DataGridTextColumn Header="置信度"
                                            Binding="{Binding ConfidenceText}"
                                            Width="90" />
                        <DataGridTextColumn Header="证据数"
                                            Binding="{Binding EvidenceCountText}"
                                            Width="70" />
                        <DataGridTextColumn Header="结果说明"
                                            Binding="{Binding Explanation}"
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4"
              Margin="0,10,0,0">
            <TextBlock x:Name="ResultStatusText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="导出仅包含已有可靠结果的 B 版偏移；跳转反汇编作用于当前选中的结果行。" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button x:Name="ExportResultsButton"
                           Margin="0,0,8,0"
                           Padding="14,6"
                           IsEnabled="False"
                           Click="OnExportResultsClick"
                           Content="导出 B 版偏移" />
                <ui:Button x:Name="JumpDisassemblyButton"
                           Margin="0,0,8,0"
                           Padding="14,6"
                           IsEnabled="False"
                           Click="OnJumpDisassemblyClick"
                           Content="跳转反汇编" />
                <ui:Button Padding="14,6"
                           Click="OnCloseClick"
                           Content="关闭" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
