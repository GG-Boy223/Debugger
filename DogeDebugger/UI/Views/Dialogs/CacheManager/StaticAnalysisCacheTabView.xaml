<UserControl x:Class="DogeDebugger.UI.Views.Dialogs.CacheManager.StaticAnalysisCacheTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Background="Transparent">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding SummaryText}" />
            <ui:Button Grid.Column="1"
                       Appearance="Secondary"
                       Padding="10,4"
                       Command="{Binding OpenCacheFolderCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24"
                                   Filled="False"
                                   FontSize="16" />
                </ui:Button.Icon>
                打开缓存目录
            </ui:Button>
        </Grid>

        <ui:ListView x:Name="CacheListView"
                     Grid.Row="1"
                     SelectionMode="Extended"
                     ItemsSource="{Binding Items}"
                     BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                     BorderThickness="1"
                     MouseDoubleClick="OnCacheListViewMouseDoubleClick"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
            <ui:ListView.View>
                <ui:GridView>
                    <GridViewColumn Width="60">
                        <GridViewColumn.Header>
                            <CheckBox x:Name="HeaderSelectAll"
                                      Checked="OnHeaderSelectAllChanged"
                                      Unchecked="OnHeaderSelectAllChanged"
                                      ToolTip="全选 / 取消全选" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="70"
                                    Header="类型">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding KindText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="370"
                                    Header="文件名">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Cascadia Code, Consolas, monospace"
                                           Text="{Binding FileName}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding FullPath}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="100"
                                    Header="大小">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock HorizontalAlignment="Right"
                                           Text="{Binding SizeText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="140"
                                    Header="修改时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="{Binding LastWriteText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </ui:GridView>
            </ui:ListView.View>
        </ui:ListView>

        <Grid Grid.Row="2"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <ui:Button Appearance="Secondary"
                           Padding="10,4"
                           Margin="0,0,6,0"
                           Command="{Binding SelectAllCommand}"
                           Content="全选" />
                <ui:Button Appearance="Secondary"
                           Padding="10,4"
                           Margin="0,0,6,0"
                           Command="{Binding InvertSelectionCommand}"
                           Content="反选" />
                <ui:Button Appearance="Secondary"
                           Padding="10,4"
                           Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24"
                                       Filled="False"
                                       FontSize="16" />
                    </ui:Button.Icon>
                    刷新
                </ui:Button>
            </StackPanel>
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                <Run Text="已选择 " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" 个文件" />
            </TextBlock>
            <ui:Button Grid.Column="2"
                       Appearance="Danger"
                       Padding="12,4"
                       Command="{Binding DeleteSelectedCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Delete24"
                                   Filled="False"
                                   FontSize="16" />
                </ui:Button.Icon>
                删除选中
            </ui:Button>
        </Grid>
    </Grid>
</UserControl>
