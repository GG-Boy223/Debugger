<Window x:Class="DogeDebugger.UI.Views.Dialogs.InstructionSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="指令搜索"
        Width="720"
        Height="520"
        MinWidth="620"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F8F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Grid Margin="10,12,10,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="322" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   VerticalAlignment="Center"
                   Text="指令" />
        <TextBox x:Name="InstructionBox"
                 Grid.Row="1"
                 Margin="0,4,0,0"
                 Padding="6,4"
                 FontFamily="Cascadia Code, Consolas, monospace"
                 FontSize="12" />

        <Grid Grid.Row="2"
              Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Text="模块" />
            <Grid Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         Height="33"
                         Padding="6,4"
                         TextChanged="OnModuleFilterChanged" />
                <TextBlock x:Name="SearchPlaceholder"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="#FF8C8C8C"
                           Text="筛选模块" />
            </Grid>
            <TextBlock x:Name="SelectionCountText"
                       Grid.Column="2"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Text="已选择 0 / 0 个模块" />
        </Grid>

        <DataGrid x:Name="ModuleListView"
                  Grid.Row="4"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="25"
                  RowHeight="36"
                  GridLinesVisibility="Horizontal"
                  BorderThickness="0"
                  Background="Transparent"
                  FontFamily="Microsoft YaHei UI"
                  FontSize="12">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Height" Value="25" />
                    <Setter Property="MinHeight" Value="25" />
                    <Setter Property="Padding" Value="4,0" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Checked="OnModuleSelectionChanged"
                                      Unchecked="OnModuleSelectionChanged" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="模块"
                                    Binding="{Binding Name}"
                                    Width="210" />
                <DataGridTextColumn Header="基址"
                                    Binding="{Binding BaseAddressText}"
                                    Width="150" />
                <DataGridTextColumn Header="大小"
                                    Binding="{Binding SizeText}"
                                    Width="90" />
                <DataGridTextColumn Header="路径"
                                    Binding="{Binding FilePath}"
                                    Width="260" />
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="5"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Width="68"
                    Height="31"
                    Padding="0"
                    Click="OnSelectAllClick"
                    Content="全选" />
            <Button Grid.Column="2"
                    Width="76"
                    Height="31"
                    Padding="0"
                    Click="OnSelectNoneClick"
                    Content="全不选" />
            <Button Grid.Column="4"
                    Width="86"
                    Height="31"
                    Padding="0"
                    Click="OnOkClick"
                    Content="确定"
                    IsDefault="True" />
            <Button Grid.Column="6"
                    Width="86"
                    Height="31"
                    Padding="0"
                    Click="OnCancelClick"
                    Content="取消"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
