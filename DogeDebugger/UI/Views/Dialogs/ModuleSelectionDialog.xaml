<Window x:Class="DogeDebugger.UI.Views.Dialogs.ModuleSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择要分析的模块"
        Width="520"
        Height="480"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox"
                        Grid.Column="0"
                        Height="32"
                        PlaceholderText="搜索模块名称"
                        TextChanged="OnSearchTextChanged" />
            <ui:Button Grid.Column="1"
                       Width="46"
                       Height="27"
                       Margin="8,0,0,0"
                       Padding="0"
                       Click="OnSelectAllClick"
                       Content="全选" />
            <ui:Button Grid.Column="2"
                       Width="70"
                       Height="27"
                       Margin="4,0,0,0"
                       Padding="0"
                       Click="OnClearSelectionClick"
                       Content="取消全选" />
        </Grid>

        <ListView x:Name="ModuleList"
                  Grid.Row="1"
                  BorderThickness="1"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Height" Value="40" />
                    <Setter Property="MinHeight" Value="40" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="40" Margin="6,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="98" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Grid Width="16" Height="16">
                                        <Border x:Name="Box"
                                                CornerRadius="2"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                Background="Transparent" />
                                        <ui:SymbolIcon x:Name="Check"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Symbol="Checkmark16"
                                                       Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Box"
                                                    Property="Background"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Box"
                                                    Property="BorderBrush"
                                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Check"
                                                    Property="Foreground"
                                                    Value="White" />
                                            <Setter TargetName="Check"
                                                    Property="Visibility"
                                                    Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <TextBlock Grid.Column="1"
                                   Margin="2,0,10,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   Text="{Binding BaseAddressText}" />
                        <TextBlock Grid.Column="3"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2"
              Margin="0,7,0,0">
            <TextBlock x:Name="SelectionText"
                       Margin="0,1,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Width="58"
                           Height="29"
                           Padding="0"
                           FontSize="11"
                           Appearance="Primary"
                           Click="OnConfirmClick"
                           Content="确定" />
                <ui:Button Width="58"
                           Height="29"
                           Margin="8,0,0,0"
                           Padding="0"
                           FontSize="11"
                           Click="OnCancelClick"
                           Content="取消" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
