<Window x:Class="DogeDebugger.UI.Views.Dialogs.ProcessSelectionWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:DogeDebugger.UI.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="打开进程"
        Width="680"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        FontFamily="{DynamicResource AppUiFontFamily}"
        FontSize="{DynamicResource AppUiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <converters:ProcessIconConverter x:Key="ProcessIconConverter" />
        <Style x:Key="ProcessListItemStyle"
               TargetType="{x:Type ListBoxItem}"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Height" Value="48" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProcessGridRowStyle"
               TargetType="{x:Type DataGridRow}"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProcessGridCellStyle"
               TargetType="{x:Type DataGridCell}"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="SearchBox"
                        Grid.Column="0"
                        Height="32"
                        Padding="8,3"
                        PlaceholderText="搜索: 输入 PID、进程名、窗口标题或路径..."
                        TextChanged="OnSearchTextChanged" />
            <ui:Button x:Name="WindowPickerButton"
                       Grid.Column="1"
                       Width="114"
                       Height="27"
                       Margin="8,0,0,0"
                       Padding="10,2"
                       FontSize="12"
                       PreviewMouseLeftButtonDown="OnWindowPickerMouseDown">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xF690;" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="拖拽选择窗口" />
                </StackPanel>
            </ui:Button>
            <ui:Button Grid.Column="2"
                       Width="66"
                       Height="27"
                       Margin="8,0,0,0"
                       Padding="8,2"
                       FontSize="12"
                       Click="OnRefreshClick">
                <StackPanel Orientation="Horizontal">
                    <ui:FontIcon Glyph="&#xF68F;" FontSize="14" Margin="0,0,8,0" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <TabControl x:Name="ProcessTabs"
                    Grid.Row="1"
                    Margin="0,8,0,0">
            <TabItem x:Name="ApplicationTab"
                     Header="应用列表"
                     FontSize="14">
                <ListBox x:Name="AppListBox"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource ProcessListItemStyle}"
                         SelectionMode="Single"
                         MouseDoubleClick="OnProcessItemDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48" Margin="17,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0"
                                       Width="16"
                                       Height="16"
                                       VerticalAlignment="Center"
                                       Source="{Binding FilePath, Converter={StaticResource ProcessIconConverter}}" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding DisplayText}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem x:Name="AllProcessesTab"
                     Header="全部进程"
                     FontSize="14">
                <DataGrid x:Name="ProcessGrid"
                          AutoGenerateColumns="False"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          ColumnHeaderHeight="32"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                          IsReadOnly="True"
                          CellStyle="{StaticResource ProcessGridCellStyle}"
                          FontSize="12"
                          MouseDoubleClick="OnProcessItemDoubleClick"
                          RowHeight="32"
                          RowStyle="{StaticResource ProcessGridRowStyle}"
                          SelectionMode="Single"
                          SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="24">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Width="16"
                                           Height="16"
                                           Margin="4,0,0,0"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Source="{Binding FilePath, Converter={StaticResource ProcessIconConverter}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PID"
                                            Width="130"
                                            Binding="{Binding PidDisplay}"
                                            SortMemberPath="ProcessId" />
                        <DataGridTextColumn Header="名称"
                                            Width="160"
                                            Binding="{Binding Name}"
                                            SortMemberPath="Name" />
                        <DataGridTextColumn Header="标题"
                                            Width="200"
                                            Binding="{Binding WindowTitle}"
                                            SortMemberPath="WindowTitle" />
                        <DataGridTextColumn Header="路径"
                                            Width="*"
                                            Binding="{Binding FilePath}"
                                            SortMemberPath="FilePath" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProcessCountText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button x:Name="ConfirmButton"
                       Grid.Column="1"
                       MinWidth="82"
                       Height="29"
                       Margin="0,0,8,0"
                       Padding="12,3"
                       Appearance="Primary"
                       FontSize="12"
                       Click="OnConfirmClick"
                       Content="打开进程"
                       IsDefault="True" />
            <ui:Button Grid.Column="2"
                       MinWidth="58"
                       Height="29"
                       Padding="12,3"
                       FontSize="12"
                       Click="OnCancelClick"
                       Content="取消"
                       IsCancel="True" />
        </Grid>
    </Grid>
</Window>
