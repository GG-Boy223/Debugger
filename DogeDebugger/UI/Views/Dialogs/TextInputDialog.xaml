<Window x:Class="DogeDebugger.UI.Views.Dialogs.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Width="450"
        SizeToContent="Height"
        MinHeight="160"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F8F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Grid Margin="14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText"
                   Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap" />
        <TextBox x:Name="ValueTextBox"
                 Grid.Row="1"
                 MinHeight="30"
                 Padding="6,5"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" />
        <Grid Grid.Row="2"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1"
                       x:Name="ConfirmButton"
                       Width="80"
                       Height="27"
                       MinHeight="27"
                       HorizontalAlignment="Center"
                       Appearance="Primary"
                       Click="OnOkClick"
                       Content="确定"
                       IsDefault="True" />
            <ui:Button Grid.Column="3"
                       Width="80"
                       Height="27"
                       MinHeight="27"
                       HorizontalAlignment="Center"
                       Appearance="Secondary"
                       Click="OnCancelClick"
                       Content="取消"
                       IsCancel="True" />
        </Grid>
    </Grid>
</Window>
