<Window x:Class="DogeDebugger.UI.Views.Dialogs.ConditionBreakpointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="条件断点"
        Width="520"
        Height="280"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F8F8"
        Foreground="#E4000000"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   MinHeight="17"
                   FontWeight="SemiBold"
                   Text="条件断点" />

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,5"
                   Text="断点条件 (Lua 表达式,寄存器必须用大写字母!):" />

        <TextBox x:Name="ConditionBox"
                 Grid.Row="2"
                 Width="472"
                 HorizontalAlignment="Left"
                 AutomationProperties.AutomationId="ConditionBox"
                 Padding="6,5"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 VerticalContentAlignment="Top"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code, Consolas, monospace"
                 FontSize="11"
                 TextChanged="OnConditionTextChanged" />

        <Expander x:Name="ExamplesExpander"
                  Grid.Row="3"
                  Margin="0,8,0,0"
                  Header="示例参考"
                  Expanded="OnExamplesExpanded"
                  Collapsed="OnExamplesCollapsed">
            <ScrollViewer MaxHeight="260"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ExampleList"
                            Margin="12,8,4,8" />
            </ScrollViewer>
        </Expander>

        <TextBlock x:Name="ValidationText"
                   Grid.Row="4"
                   Margin="0,6,0,0"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" />

        <Grid Grid.Row="5"
              Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       Width="70"
                       Height="27"
                       MinHeight="27"
                       Appearance="Secondary"
                       Click="OnValidateClick"
                       Content="验证" />
            <ui:Button Grid.Column="2"
                       Width="80"
                       Height="27"
                       MinHeight="27"
                       Appearance="Secondary"
                       Click="OnClearClick"
                       Content="清除条件" />
            <ui:Button Grid.Column="4"
                       Width="80"
                       Height="27"
                       MinHeight="27"
                       Appearance="Secondary"
                       Click="OnOkClick"
                       Content="确定"
                       IsDefault="True" />
            <ui:Button Grid.Column="6"
                       Width="80"
                       Height="27"
                       MinHeight="27"
                       Appearance="Secondary"
                       Click="OnCancelClick"
                       Content="取消"
                       IsCancel="True" />
        </Grid>
    </Grid>
</Window>
