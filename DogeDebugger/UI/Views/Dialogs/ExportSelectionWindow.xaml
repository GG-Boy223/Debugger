<Window x:Class="DogeDebugger.UI.Views.Dialogs.ExportSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择导出函数"
        Width="520"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource AppUiFontFamily}"
        FontSize="{DynamicResource AppUiFontSize}"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TextBox x:Name="SearchBox"
                    Grid.Row="0"
                    Height="30"
                    PlaceholderText="搜索导出函数..."
                    TextChanged="OnSearchTextChanged" />

        <ListBox x:Name="ExportList"
                 Grid.Row="1"
                 Margin="0,10,0,10"
                 MouseDoubleClick="OnExportDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding Ordinal, StringFormat=Ord #{0}}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ui:Button Width="80"
                       Height="30"
                       Margin="0,0,8,0"
                       Appearance="Primary"
                       Click="OnConfirmClick"
                       Content="选择" />
            <ui:Button Width="80"
                       Height="30"
                       Click="OnCancelClick"
                       Content="取消" />
        </StackPanel>
    </Grid>
</Window>
