<ui:FluentWindow x:Class="DogeDebugger.UI.Views.Dialogs.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Width="1241"
                 Height="640"
                 MinWidth="980"
                 MinHeight="560"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource AppUiFontFamily}"
                 FontSize="{DynamicResource AppUiFontSize}"
                 Background="#FFF7F7F7">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Margin="18,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="设置" />
            <ui:Button Width="44"
                       Height="30"
                       Padding="0"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Background="Transparent"
                       BorderThickness="0"
                       Click="OnCancelClick"
                       ToolTip="关闭">
                <ui:SymbolIcon Symbol="Dismiss12" />
            </ui:Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NavigationList"
                     Grid.Column="0"
                     Margin="0"
                     Padding="0,4"
                     BorderThickness="0"
                     Background="#FFF7F7F7"
                     SelectionChanged="OnNavigationSelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0"
                                           Margin="4,0,0,0"
                                           VerticalAlignment="Center"
                                           Symbol="{Binding Symbol}" />
                            <TextBlock Grid.Column="1"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Title}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Background="#FFE2E2E2" />

            <Grid Grid.Column="2">
                <ScrollViewer x:Name="GeneralPage"
                              Padding="36,18,36,12"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Text="常规" />

                        <TextBlock Margin="0,20,0,0"
                                   FontWeight="SemiBold"
                                   Text="进程" />
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="White"
                                BorderBrush="#FFE2E2E2"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Window20"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="打开新进程时提示清空列表" />
                                    <TextBlock Foreground="#FF777777"
                                               FontSize="11"
                                               Text="打开新的目标进程时，询问是否清空数据搜索中已保存的地址列表" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="AskClearListToggle"
                                                 Grid.Column="2"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,16,0,0"
                                   FontWeight="SemiBold"
                                   Text="符号" />
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="White"
                                BorderBrush="#FFE2E2E2"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="430" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Database20"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="PDB 符号服务器" />
                                    <TextBlock Foreground="#FF777777"
                                               FontSize="11"
                                               Text="用于下载系统模块 PDB，缓存到 Saved/Symbols" />
                                </StackPanel>
                                <ui:TextBox x:Name="SymbolServerTextBox"
                                            Grid.Column="2"
                                            Height="28"
                                            VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,16,0,0"
                                   FontWeight="SemiBold"
                                   Text="界面" />
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="White"
                                BorderBrush="#FFE2E2E2"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Window20"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="保存主界面窗口位置和大小" />
                                    <TextBlock Foreground="#FF777777"
                                               FontSize="11"
                                               Text="关闭软件时保存窗口位置、大小以及各面板的布局组合，下次启动时恢复" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="SaveWindowLayoutToggle"
                                                 Grid.Column="2"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="White"
                                BorderBrush="#FFE2E2E2"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="CodeText20"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="显示底部脚本栏" />
                                    <TextBlock Foreground="#FF777777"
                                               FontSize="11"
                                               Text="在主窗口底部显示可快速执行 Lua 脚本命令的输入栏" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="ShowScriptConsoleToggle"
                                                 Grid.Column="2"
                                                 VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Margin="0,16,0,0"
                                   FontWeight="SemiBold"
                                   Text="搜索" />
                        <Border Margin="0,8,0,0"
                                Padding="12"
                                Background="White"
                                BorderBrush="#FFE2E2E2"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0"
                                               Symbol="Search20"
                                               VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="数据锁定写入间隔" />
                                    <TextBlock Foreground="#FF777777"
                                               FontSize="11"
                                               Text="地址列表中勾选锁定后，以此间隔持续向目标进程写入锁定值（毫秒）" />
                                </StackPanel>
                                <ui:NumberBox x:Name="ValueLockIntervalNumberBox"
                                              Grid.Column="2"
                                              Height="30"
                                              Minimum="1"
                                              Maximum="60000"
                                              SmallChange="1"
                                              SpinButtonPlacementMode="Compact" />
                                <TextBlock Grid.Column="3"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="ms" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ShortcutPage"
                              Padding="36,18,36,12"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Text="快捷键" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#FF777777"
                                   Text="显示当前程序已注册的命令和默认快捷键。" />
                        <ListBox x:Name="ShortcutList"
                                 Margin="0,18,0,0"
                                 BorderBrush="#FFE2E2E2"
                                 BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="1"
                                                   Foreground="#FF1769AA"
                                                   Text="{Binding Gesture}" />
                                        <TextBlock Grid.Column="2"
                                                   Foreground="#FF777777"
                                                   Text="{Binding Description}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="DynamicPage"
                              Padding="36,18,36,12"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DynamicPageContent" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Background="#FFFAFAFA"
                BorderBrush="#FFE2E2E2"
                BorderThickness="0,1,0,0">
            <StackPanel Margin="0,0,20,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <ui:Button Width="92"
                           Height="32"
                           Margin="0,0,10,0"
                           Appearance="Primary"
                           Click="OnSaveClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Checkmark16" Margin="0,0,5,0" />
                        <TextBlock Text="保存" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Width="72"
                           Height="32"
                           Click="OnCancelClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss12" Margin="0,0,5,0" />
                        <TextBlock Text="取消" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
