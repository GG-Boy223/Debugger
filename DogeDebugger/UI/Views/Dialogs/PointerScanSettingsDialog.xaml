<Window x:Class="DogeDebugger.UI.Views.Dialogs.PointerScanSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="指针扫描设置"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#FFFAFAFA"
        Foreground="#E4000000">
    <Grid Background="#FFFAFAFA"
          Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,4"
                   FontWeight="SemiBold"
                   Foreground="#E4000000"
                   Text="目标地址 (16进制):" />
        <TextBox x:Name="TargetAddressBox"
                 Grid.Row="1"
                 Margin="0,0,0,10"
                 FontFamily="Consolas" />

        <Grid Grid.Row="2"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,4"
                           Foreground="#E4000000"
                           Text="最大深度:" />
                <TextBox x:Name="MaxDepthBox"
                         Text="5" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4"
                           Foreground="#E4000000"
                           Text="最大偏移 (16进制):" />
                <TextBox x:Name="MaxOffsetBox"
                         FontFamily="Consolas"
                         Text="1000" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,4"
                           Foreground="#E4000000"
                           Text="指针对齐:" />
                <ComboBox x:Name="AlignmentCombo"
                          SelectedIndex="1">
                    <ComboBoxItem Tag="1">1 (不对齐)</ComboBoxItem>
                    <ComboBoxItem Tag="4">4 (四字节对齐)</ComboBoxItem>
                    <ComboBoxItem Tag="8">8 (八字节对齐)</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4"
                           Foreground="#E4000000"
                           Text="最大结果数:" />
                <TextBox x:Name="MaxResultsBox"
                         Text="10000000" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4"
                    Margin="0,0,0,6"
                    Orientation="Horizontal">
            <CheckBox x:Name="LimitOffsetsPerNodeCheck"
                      VerticalAlignment="Center"
                      Foreground="#E4000000"
                      IsChecked="True"
                      Content="每节点最大偏移变体数:" />
            <TextBox x:Name="MaxOffsetsPerNodeBox"
                     Width="60"
                     Margin="8,0,0,0"
                     IsEnabled="True"
                     Text="3" />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Margin="0,0,0,10">
            <CheckBox x:Name="StaticOnlyBaseCheck"
                      Margin="0,2"
                      Foreground="#E4000000"
                      IsChecked="True"
                      Content="仅静态基址 (模块范围内)" />
            <CheckBox x:Name="IncludeMappedMemoryCheck"
                      Margin="0,2"
                      Foreground="#E4000000"
                      Content="包含 MEM_MAPPED 内存" />
            <CheckBox x:Name="AllowNegativeOffsetsCheck"
                      Margin="0,2"
                      Foreground="#E4000000"
                      Content="允许负偏移" />
        </StackPanel>

        <Separator x:Name="RescanSeparator"
                   Grid.Row="6"
                   Margin="0,4"
                   Visibility="Collapsed" />
        <TextBlock x:Name="RescanTitle"
                   Grid.Row="7"
                   Margin="0,4"
                   FontWeight="SemiBold"
                   Foreground="#E4000000"
                   Text="重扫描设置"
                   Visibility="Collapsed" />
        <Grid x:Name="RescanModePanel"
              Grid.Row="8"
              Margin="0,0,0,10"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Margin="0,0,0,4"
                           Foreground="#E4000000"
                           Text="重扫描模式:" />
                <ComboBox x:Name="RescanModeCombo"
                          SelectedIndex="0">
                    <ComboBoxItem>扫描地址</ComboBoxItem>
                    <ComboBoxItem>扫描数值</ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Margin="0,0,0,4"
                           Foreground="#E4000000"
                           Text="值类型:" />
                <ComboBox x:Name="RescanValueTypeCombo"
                          SelectedIndex="0">
                    <ComboBoxItem>Byte</ComboBoxItem>
                    <ComboBoxItem>2 Bytes</ComboBoxItem>
                    <ComboBoxItem>4 Bytes</ComboBoxItem>
                    <ComboBoxItem>8 Bytes</ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>
        <StackPanel x:Name="RescanTargetPanel"
                    Grid.Row="9"
                    Margin="0,0,0,10"
                    Visibility="Collapsed">
            <TextBlock Margin="0,0,0,4"
                       Foreground="#E4000000"
                       Text="目标地址/值 (16进制):" />
            <TextBox x:Name="RescanTargetBox"
                     FontFamily="Consolas" />
        </StackPanel>

        <StackPanel Grid.Row="10"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="80"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    Click="OnConfirmClick"
                    Content="确定" />
            <Button Width="80"
                    IsCancel="True"
                    Click="OnCancelClick"
                    Content="取消" />
        </StackPanel>
    </Grid>
</Window>
