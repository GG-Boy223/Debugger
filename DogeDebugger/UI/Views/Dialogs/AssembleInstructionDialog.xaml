<Window x:Class="DogeDebugger.UI.Views.Dialogs.AssembleInstructionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="修改汇编指令"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8F8F8"
        FontFamily="Microsoft YaHei UI"
        FontSize="12">
    <StackPanel Margin="16,14">
        <TextBlock x:Name="AddressText"
                   Margin="0,0,0,4"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   FontSize="13" />
        <TextBlock x:Name="OriginalInstructionText"
                   Margin="0,0,0,8"
                   FontFamily="Cascadia Code, Consolas, monospace"
                   FontSize="13" />
        <TextBox x:Name="InstructionBox"
                 Height="31"
                 Padding="6,4"
                 FontFamily="Cascadia Code, Consolas, monospace"
                 FontSize="14" />
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="1"
                       Height="27"
                       MinHeight="27"
                       Appearance="Secondary"
                       Click="OnWriteClick"
                       Content="汇编并写入"
                       IsDefault="True" />
            <ui:Button Grid.Column="3"
                       Height="27"
                       MinHeight="27"
                       Appearance="Secondary"
                       Click="OnCancelClick"
                       Content="取消"
                       IsCancel="True" />
        </Grid>
    </StackPanel>
</Window>
