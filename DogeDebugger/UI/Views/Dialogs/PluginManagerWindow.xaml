<ui:FluentWindow x:Class="DogeDebugger.UI.Views.Dialogs.PluginManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="插件管理器"
                 Width="1040"
                 Height="640"
                 MinWidth="820"
                 MinHeight="520"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="{DynamicResource AppUiFontFamily}"
                 FontSize="{DynamicResource AppUiFontSize}"
                 Background="{DynamicResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="插件管理器"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True" />

        <Border Grid.Row="1"
                Padding="14,8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <TextBlock VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="启用状态会写入 settings.json；托管插件加载失败时会保留错误信息。" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="92"
                            Margin="0,0,8,0"
                            Click="OnRefreshClick"
                            Content="刷新" />
                    <Button Width="112"
                            Margin="0,0,8,0"
                            Click="OnLoadExternalClick"
                            Content="加载插件..." />
                    <Button Width="112"
                            Click="OnLoadSelectedClick"
                            Content="加载选中" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid x:Name="PluginGrid"
                  Grid.Row="2"
                  Margin="14"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  RowHeaderWidth="0"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="启用"
                                        Width="56"
                                        Binding="{Binding IsEnabled}" />
                <DataGridTextColumn Header="名称"
                                    Width="150"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Header="版本"
                                    Width="80"
                                    Binding="{Binding Version}" />
                <DataGridTextColumn Header="类型"
                                    Width="80"
                                    Binding="{Binding PluginType}" />
                <DataGridTextColumn Header="状态"
                                    Width="100"
                                    Binding="{Binding Status}" />
                <DataGridTextColumn Header="ID"
                                    Width="180"
                                    Binding="{Binding Id}" />
                <DataGridTextColumn Header="说明"
                                    Width="*"
                                    Binding="{Binding Description}" />
                <DataGridTextColumn Header="错误"
                                    Width="180"
                                    Binding="{Binding Error}" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3"
                Padding="14,9"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="SummaryText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Width="100"
                            Margin="0,0,8,0"
                            Click="OnToggleSelectedClick"
                            Content="启用 / 禁用" />
                    <Button Width="100"
                            Margin="0,0,8,0"
                            Click="OnUnloadSelectedClick"
                            Content="卸载" />
                    <Button Width="100"
                            Margin="0,0,8,0"
                            Click="OnRemoveSelectedClick"
                            Content="删除插件" />
                    <Button Width="88"
                            Click="OnCloseClick"
                            Content="关闭" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
